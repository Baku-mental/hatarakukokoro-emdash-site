---
import { getSiteSettingsWithCacheHint } from "emdash";
import {
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import {
	CATEGORIES,
	FOOTER_LINKS,
	KENSHU,
	LINKS,
	NAV_CATEGORIES,
	SITE,
} from "../site-config";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;

// The header and footer links are hardcoded in src/site-config.ts, so only
// the site settings (title, tagline, logo) are read here; no menu query.
const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
}

const { siteTitle, siteLogo } = resolveBlogSiteIdentity(
	settingsResult.data,
);

// 「ページ名｜はたらくこころ研究所」. Titles that already carry the site name
// (the home page, or post SEO titles built by getSeoMeta) are left alone,
// except that getSeoMeta's " | " separator is turned into the full-width bar.
function buildTitle(raw: string): string {
	if (raw === siteTitle) return raw;
	for (const separator of [" | ", " — ", " - "]) {
		const suffix = `${separator}${siteTitle}`;
		if (raw.endsWith(suffix)) {
			return `${raw.slice(0, -suffix.length)}｜${siteTitle}`;
		}
	}
	if (raw.endsWith(`｜${siteTitle}`) || raw.startsWith(`${siteTitle}｜`)) {
		return raw;
	}
	return `${raw}｜${siteTitle}`;
}
const fullTitle = buildTitle(title);

// 本番（remental.co.jp）以外（試験用の workers.dev）は検索エンジンに載せない。
// canonical は常に本番の住所で書く
const isProduction = Astro.url.hostname === new URL(SITE.origin).hostname;
const canonicalUrl = (() => {
	const raw = canonical ?? Astro.url.pathname;
	try {
		const u = new URL(raw, Astro.url.origin);
		return `${SITE.origin}${u.pathname}`;
	} catch {
		return null;
	}
})();
const robotsMeta = isProduction ? robots : "noindex, nofollow";

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical: canonicalUrl,
	image,
	content,
	seo: { ogImage: image, robots: robotsMeta },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});


const TRAILING_SLASH = /\/$/;
const currentPath = Astro.url.pathname.replace(TRAILING_SLASH, "") || "/";

/** "page" for the current page, "true" for its parent section. */
function navCurrent(href: string): "page" | "true" | undefined {
	href = href.replace(TRAILING_SLASH, "") || "/";
	if (href === currentPath) return "page";
	if (currentPath.startsWith(`${href}/`)) return "true";
	return undefined;
}

// The site is Japanese-only; content is stored with locale "en", so the
// language is not taken from the i18n config.
const lang = "ja";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<EmDashHead page={pageCtx} />
		{
			isProduction && SITE.ga4 && (
				<>
					<script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4}`} />
					<script is:inline define:vars={{ id: SITE.ga4 }}>
						window.dataLayer = window.dataLayer || [];
						function gtag() {
							dataLayer.push(arguments);
						}
						gtag("js", new Date());
						gtag("config", id);
						// 申し込み・資料フォーム（Jicoo）へのボタンが押されたら、どのフォームを、ページのどこから開いたかを GA4 に送る
						// （Jicoo 側には GA4 を入れていないので、サイトで分かるのはここまで）
						var FORMS = { TsIogv9EWwor: "組織診断", "37kJrBL59zGV": "資料請求", LeMBxTC8QLak: "研修相談", "9PWI47WQnBGw": "講師申し込み" };
						var PLACES = [
							[".site-header", "ヘッダー"], [".home-hero", "トップ"], [".k-cta-mid", "記事_文中"],
							[".k-cta-foot", "記事_記事末"], [".banner--inline", "記事_バナー"], [".banner--rail", "記事_右バナー"], [".rail-cta", "記事_右追従"], [".cta-dock", "記事_下バー"], [".cta-band", "下の帯"],
							[".kn-modal", "研修ナビ_ポップアップ"], [".kn-provider", "研修ナビ_講師募集"], [".kn-card", "研修ナビ_カード"], [".kn-hero", "研修ナビ_上"], [".site-footer", "フッター"],
						];
						document.addEventListener("click", function (e) {
							var a = e.target.closest && e.target.closest('a[href*="jicoo.com/"]');
							if (!a) return;
							var m = a.href.match(/\/[fe]\/([A-Za-z0-9]+)/);
							var place = "その他";
							for (var i = 0; i < PLACES.length; i++) {
								if (a.closest(PLACES[i][0])) { place = PLACES[i][1]; break; }
							}
							gtag("event", "cta_click", {
								form_name: (m && FORMS[m[1]]) || "その他",
								cta_place: place,
								link_text: (a.textContent || a.querySelector("img")?.alt || "").trim().slice(0, 40),
								transport_type: "beacon",
							});
						});
					</script>
				</>
			)
		}
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS`}
			href="/business/rss.xml"
		/>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">本文へ移動</a>
		<header class="site-header">
			<div class="frame site-header__inner">
				<a href="/business/" class="brand">
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								class="brand__logo"
							/>
						) : (
							<>
								<span class="brand__mark" aria-hidden="true">
									<svg viewBox="0 0 24 24"><path d="M12 20.2s-7.6-4.5-7.6-10.1A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.6 2.5c0 5.6-7.6 10.1-7.6 10.1Z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" /><path d="M15.6 3.6l.9-1.6M18.4 5.2l1.6-.9M13.6 3.2l-.1-1.8" stroke="#efb03d" stroke-width="1.8" stroke-linecap="round" /></svg>
								</span>
								<span class="brand__text">
									<span class="brand__name">{siteTitle}</span>
									<span class="brand__tagline">企業のメンタルヘルス実務メディア</span>
								</span>
							</>
						)
					}
				</a>
				<a href={LINKS.diagnosis} class="header-cta" target="_blank" rel="noopener">
					無料の組織診断
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
				</a>
			</div>
			<nav class="site-nav" aria-label="サイト内のメニュー">
				<div class="frame">
					<ul class="site-nav__list">
						{
							NAV_CATEGORIES.map((category) => {
								const href = `/business/category/${category.slug}/`;
								return (
									<li>
										<a href={href} aria-current={navCurrent(href)}>
											{category.label}
										</a>
									</li>
								);
							})
						}
						<li class="site-nav__sep" aria-hidden="true"></li>
						<li>
							<a href={KENSHU.path} aria-current={navCurrent(KENSHU.path)} class="site-nav__kenshu">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8.5 12 4l9 4.5-9 4.5L3 8.5Z M7 10.5v4.2c0 1.4 2.2 2.8 5 2.8s5-1.4 5-2.8v-4.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
								研修ナビ
							</a>
						</li>
					</ul>
				</div>
			</nav>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="frame site-footer__grid">
				<div class="site-footer__brand">
					<a href="/business/" class="brand">
						<span class="brand__name">{siteTitle}</span>
					</a>
					<p class="site-footer__tagline">{SITE.tagline}</p>
					<p class="site-footer__operator">
						運営：<a href={SITE.operatorUrl} target="_blank" rel="noopener"
							>{SITE.operator}</a
						>
					</p>
				</div>
				<nav class="site-footer__col" aria-labelledby="footer-categories">
					<h2 id="footer-categories" class="site-footer__heading">カテゴリ</h2>
					<ul class="site-footer__links">
						{
							CATEGORIES.map((category) => (
								<li>
									<a href={`/business/category/${category.slug}/`}>{category.label}</a>
								</li>
							))
						}
					</ul>
				</nav>
				<nav class="site-footer__col" aria-labelledby="footer-about">
					<h2 id="footer-about" class="site-footer__heading">このサイトについて</h2>
					<ul class="site-footer__links">
						{
							FOOTER_LINKS.map((link) => (
								<li>
									<a
										href={link.href}
										target={link.external ? "_blank" : undefined}
										rel={link.external ? "noopener" : undefined}
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
			<div class="site-footer__bottom">
				<div class="frame site-footer__bottom-inner">
					<p class="site-footer__meta">© {year} {SITE.operator}</p>
				</div>
			</div>
		</footer>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
					-webkit-text-size-adjust: 100%;
				}

				/*
				 * Fragment targets clear the sticky header. Not a scroll-padding
				 * on html: that also applies to the search field inside the
				 * header, and the page scrolls on every keystroke.
				 * --header-height is measured by a script, since the header
				 * grows when the menu wraps.
				 */
				:target {
					scroll-margin-block-start: calc(
						var(--header-height, var(--nav-height)) + var(--spacing-6)
					);
				}

				body {
					display: flex;
					flex-direction: column;
					min-height: 100vh;
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-normal);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
				}

				/*
				 * The frame rails: two hairlines that run the full height of
				 * the page at the edges of the content frame. Fixed and behind
				 * everything, so any surface with a background covers them.
				 */
				body::before {
					content: "";
					position: fixed;
					inset-block: 0;
					inset-inline: 0;
					z-index: -1;
					width: var(--frame-width);
					margin-inline: auto;
					border-inline: 1px solid var(--color-border);
					pointer-events: none;
				}

				main {
					flex: 1;
				}

				main:focus {
					outline: none;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration-line: underline;
					text-decoration-thickness: 1px;
					text-decoration-color: var(--color-border-strong);
					text-underline-offset: 0.2em;
					transition:
						color var(--transition-fast),
						text-decoration-color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					text-decoration-color: currentColor;
				}

				:where(:not([class*="emdash"]):not([class*="ec-"])):focus-visible {
					outline: 2px solid var(--color-brand);
					outline-offset: 2px;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
					text-wrap: balance;
					overflow-wrap: break-word;
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				p {
					text-wrap: pretty;
				}

				kbd {
					font-family: var(--font-mono);
				}

				@media (max-width: 640px) {
					:target {
						scroll-margin-block-start: var(--spacing-6);
					}
				}

				@media (prefers-reduced-motion: reduce) {
					html {
						scroll-behavior: auto;
					}

					*,
					*::before,
					*::after {
						transition-duration: 0.01ms !important;
						animation-duration: 0.01ms !important;
						animation-iteration-count: 1 !important;
					}
				}

				/* Shared building blocks used by every page */

				.sr-only {
					position: absolute;
					width: 1px;
					height: 1px;
					padding: 0;
					margin: -1px;
					overflow: hidden;
					clip-path: inset(50%);
					white-space: nowrap;
					border: 0;
				}

				.skip-link {
					position: fixed;
					top: var(--spacing-2);
					inset-inline-start: var(--spacing-2);
					z-index: 200;
					padding: var(--spacing-2) var(--spacing-4);
					border-radius: var(--radius-full);
					background: var(--color-brand);
					color: var(--color-on-brand);
					font-size: var(--font-size-sm);
					font-weight: 500;
					text-decoration: none;
					translate: 0 calc(-100% - var(--spacing-4));
					transition: translate var(--transition-fast);
				}

				.skip-link:focus-visible {
					translate: 0 0;
				}

				/* Content frame: aligned with the rails */
				.frame {
					width: var(--frame-width);
					margin-inline: auto;
					padding-inline: var(--frame-padding);
				}

				/* A full-bleed horizontal section, ruled off with a hairline */
				.band {
					position: relative;
					border-top: 1px solid var(--color-border);
				}

				/* Crosshairs where the band's rule meets the rails */
				.band::before,
				.band::after {
					content: "";
					position: absolute;
					top: -5px;
					width: 9px;
					height: 9px;
					background:
						linear-gradient(
								var(--color-border-strong),
								var(--color-border-strong)
							)
							center / 1px 100% no-repeat,
						linear-gradient(
								var(--color-border-strong),
								var(--color-border-strong)
							)
							center / 100% 1px no-repeat;
					pointer-events: none;
				}

				.band::before {
					inset-inline-start: calc((100% - var(--frame-width)) / 2 - 4px);
				}

				.band::after {
					inset-inline-end: calc((100% - var(--frame-width)) / 2 - 4px);
				}

				main > .band:first-child {
					border-top: 0;
				}

				main > .band:first-child::before,
				main > .band:first-child::after {
					content: none;
				}

				/* Vertical rhythm for content bands */
				.section {
					padding-block: clamp(2.5rem, 1.75rem + 2.5vw, 4rem);
				}

				/* Page intro: eyebrow, display title, optional lead */
				.intro {
					padding-block: clamp(3rem, 2rem + 4vw, 5.5rem)
						clamp(2.5rem, 1.75rem + 2.5vw, 3.5rem);
				}

				.intro__title {
					font-size: var(--font-size-display);
					line-height: 1.05;
					max-width: 22ch;
				}

				.intro__subtitle {
					font-size: var(--font-size-display);
					font-weight: var(--font-weight-display);
					line-height: 1.05;
					letter-spacing: var(--tracking-tight);
					color: var(--color-muted);
					max-width: 22ch;
					text-wrap: balance;
					overflow-wrap: break-word;
				}

				.intro__lead {
					margin-top: var(--spacing-5);
					font-size: var(--font-size-lg);
					line-height: var(--leading-normal);
					color: var(--color-text-secondary);
					max-width: 60ch;
					overflow-wrap: break-word;
				}

				.eyebrow + .intro__title {
					margin-top: var(--spacing-4);
				}

				/* Mono uppercase label */
				.eyebrow {
					font-family: var(--font-mono);
					font-size: var(--font-size-label);
					font-weight: 500;
					line-height: var(--leading-snug);
					letter-spacing: var(--tracking-wider);
					text-transform: uppercase;
					color: var(--color-muted);
				}

				/* Section heading row: title on the start side, link on the end */
				.section-head {
					display: flex;
					align-items: baseline;
					justify-content: space-between;
					gap: var(--spacing-4);
					margin-bottom: var(--spacing-6);
				}

				.section-head__title {
					font-size: var(--font-size-xl);
				}

				.arrow-link {
					display: inline-flex;
					align-items: center;
					gap: var(--spacing-1);
					font-size: var(--font-size-sm);
					font-weight: 500;
					color: var(--color-text-secondary);
					text-decoration: none;
					white-space: nowrap;
					transition: color var(--transition-fast);
				}

				.arrow-link:hover {
					color: var(--color-text);
				}

				.arrow-link svg {
					width: 16px;
					height: 16px;
					transition: translate var(--transition-fast);
				}

				.arrow-link:hover svg {
					translate: 2px 0;
				}

				:dir(rtl) .arrow-link svg {
					scale: -1 1;
				}

				:dir(rtl) .arrow-link:hover svg {
					translate: -2px 0;
				}

				/* Tag pills */
				.chips {
					display: flex;
					flex-wrap: wrap;
					gap: var(--spacing-2);
					list-style: none;
					padding: 0;
				}

				.chips > li {
					min-width: 0;
					max-width: 100%;
				}

				.chip {
					display: inline-block;
					max-width: 100%;
					overflow: hidden;
					padding: var(--tag-padding-y) 10px;
					border-radius: var(--radius-full);
					background: var(--color-surface);
					box-shadow: inset 0 0 0 1px var(--color-border);
					font-size: var(--font-size-xs);
					font-weight: 500;
					line-height: 1.375rem;
					color: var(--color-text-secondary);
					text-decoration: none;
					text-overflow: ellipsis;
					white-space: nowrap;
					vertical-align: middle;
					transition:
						color var(--transition-fast),
						box-shadow var(--transition-fast);
				}

				.chip:hover {
					color: var(--color-text);
					box-shadow: inset 0 0 0 1px var(--color-border-strong);
				}

				/* Pill buttons */
				.btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					gap: var(--spacing-2);
					min-height: 2.5rem;
					padding: var(--spacing-2) var(--spacing-5);
					border: 0;
					border-radius: var(--radius-full);
					background: var(--color-brand);
					color: var(--color-on-brand);
					font: inherit;
					font-size: var(--font-size-sm);
					font-weight: 500;
					line-height: 1;
					white-space: nowrap;
					text-decoration: none;
					cursor: pointer;
					transition:
						background-color var(--transition-fast),
						color var(--transition-fast),
						box-shadow var(--transition-fast),
						scale var(--transition-fast);
				}

				.btn:hover {
					background: var(--color-brand-hover);
				}

				.btn:active {
					scale: 0.96;
				}

				.btn svg {
					width: 16px;
					height: 16px;
					flex-shrink: 0;
				}

				.btn--ghost {
					background: var(--color-surface);
					color: var(--color-text);
					box-shadow:
						inset 0 0 0 1px var(--color-border),
						var(--shadow-sm);
				}

				.btn--ghost:hover {
					background: var(--color-surface);
					box-shadow:
						inset 0 0 0 1px var(--color-border-strong),
						var(--shadow-sm);
				}

				.btn--sm {
					min-height: 2rem;
					padding: var(--spacing-1) var(--spacing-3);
					font-size: var(--font-size-xs);
				}

				.icon-btn {
					display: inline-grid;
					place-items: center;
					width: 2.25rem;
					height: 2.25rem;
					border-radius: var(--radius-full);
					background: var(--color-surface);
					box-shadow: inset 0 0 0 1px var(--color-border);
					color: var(--color-text-secondary);
					text-decoration: none;
					transition:
						color var(--transition-fast),
						box-shadow var(--transition-fast);
				}

				.icon-btn:hover {
					color: var(--color-text);
					box-shadow: inset 0 0 0 1px var(--color-border-strong);
				}

				.icon-btn svg {
					width: 16px;
					height: 16px;
				}

				/* Responsive card grid */
				.post-grid {
					display: grid;
					grid-template-columns: repeat(
						auto-fill,
						minmax(min(100%, 300px), 1fr)
					);
					gap: var(--spacing-6);
				}

				/* Empty and not-found states */
				.empty-state {
					display: flex;
					flex-direction: column;
					align-items: center;
					gap: var(--spacing-3);
					max-width: 420px;
					margin-inline: auto;
					padding-block: var(--spacing-16);
					text-align: center;
				}

				.empty-state__title {
					font-size: var(--font-size-2xl);
				}

				.empty-state__text {
					color: var(--color-text-secondary);
				}

				.empty-state__actions {
					display: flex;
					flex-wrap: wrap;
					justify-content: center;
					gap: var(--spacing-3);
					margin-top: var(--spacing-3);
				}
			}
		</style>

		<style>
			/* ヘッダー: 1段目にロゴと申し込みボタン（1つだけ）、2段目にメニュー */
			.site-header {
				position: relative;
				z-index: 50;
				background: var(--color-surface);
				box-shadow: 0 1px 0 var(--color-border), 0 4px 16px -12px rgb(0 47 87 / 0.25);
			}

			.site-header__inner {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: var(--spacing-4);
				min-height: 68px;
				padding-block: 10px;
			}

			.brand {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				min-width: 0;
				color: var(--color-navy);
				text-decoration: none;
			}

			.brand__mark {
				display: grid;
				flex: none;
				place-items: center;
				width: 38px;
				height: 38px;
				border-radius: 11px;
				background: var(--color-teal-bg);
				color: var(--color-teal);
			}

			.brand__mark svg {
				width: 24px;
				height: 24px;
			}

			.brand__text {
				display: grid;
				min-width: 0;
				line-height: 1.25;
			}

			.brand__name {
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				font-size: 1.1875rem;
				font-weight: 800;
				letter-spacing: 0.05em;
			}

			.brand__tagline {
				margin-block-start: 2px;
				font-size: 0.6875rem;
				font-weight: 500;
				letter-spacing: 0.08em;
				color: var(--color-text-secondary);
			}

			.brand:hover .brand__name {
				color: var(--color-teal-dark);
			}

			.brand__logo {
				height: 36px;
				width: auto;
				max-width: 220px;
				object-fit: contain;
			}

			.header-cta {
				display: inline-flex;
				flex: none;
				align-items: center;
				gap: 6px;
				padding: 10px 18px;
				border-radius: 999px;
				background: var(--color-teal);
				color: #fff;
				font-size: 0.875rem;
				font-weight: 700;
				line-height: 1.2;
				text-decoration: none;
				box-shadow: 0 4px 12px -6px rgb(47 131 137 / 0.7);
				transition:
					background-color var(--transition-fast),
					transform var(--transition-fast);
			}

			.header-cta svg {
				width: 16px;
				height: 16px;
				transition: transform var(--transition-fast);
			}

			.header-cta:hover {
				background: var(--color-teal-dark);
				color: #fff;
			}

			.header-cta:hover svg {
				transform: translateX(2px);
			}

			/* メニュー: タブ型（下線で現在地）。研修ナビは区切り線のあとに並べる */
			.site-nav {
				border-top: 1px solid var(--color-border-subtle);
			}

			.site-nav__list {
				display: flex;
				align-items: stretch;
				gap: 4px;
				margin: 0 -12px;
				padding: 0;
				overflow-x: auto;
				list-style: none;
				scrollbar-width: none;
			}

			.site-nav__list::-webkit-scrollbar {
				display: none;
			}

			.site-nav a {
				position: relative;
				display: flex;
				align-items: center;
				gap: 6px;
				height: 46px;
				padding: 0 12px;
				font-size: 0.875rem;
				font-weight: 600;
				color: var(--color-text);
				text-decoration: none;
				white-space: nowrap;
				transition: color var(--transition-fast);
			}

			.site-nav a::after {
				content: "";
				position: absolute;
				inset: auto 12px 0;
				height: 3px;
				border-radius: 3px 3px 0 0;
				background: var(--color-teal);
				transform: scaleX(0);
				transition: transform var(--transition-fast);
			}

			.site-nav a:hover {
				color: var(--color-teal-dark);
			}

			.site-nav a:hover::after,
			.site-nav a[aria-current]::after {
				transform: scaleX(1);
			}

			.site-nav a[aria-current] {
				color: var(--color-teal-dark);
			}

			.site-nav__sep {
				flex: none;
				width: 1px;
				margin: 14px 6px;
				background: var(--color-border);
			}

			.site-nav__kenshu svg {
				width: 18px;
				height: 18px;
				color: var(--color-teal);
			}

			.site-search {
				position: relative;
				width: var(--search-input-width);
			}

			.site-search__icon {
				position: absolute;
				inset-inline-start: 12px;
				top: 50%;
				z-index: 1;
				width: 16px;
				height: 16px;
				translate: 0 -50%;
				color: var(--color-muted);
				pointer-events: none;
			}

			.site-search :global(.site-search__field) {
				display: block;
				width: 100%;
			}

			.site-search :global(.site-search-input) {
				width: 100%;
				height: 38px;
				padding-block: 0;
				padding-inline: 36px 12px;
				border: 1px solid var(--color-border);
				border-radius: var(--radius-full);
				background: var(--color-offwhite);
				color: var(--color-text);
				font-family: var(--font-body);
				font-size: var(--font-size-sm);
				transition:
					border-color var(--transition-fast),
					box-shadow var(--transition-fast);
			}

			.site-search :global(.site-search-input)::placeholder {
				color: var(--color-muted);
			}

			.site-search :global(.site-search-input):hover {
				border-color: var(--color-border-strong);
			}

			.site-search :global(.site-search-input):focus {
				outline: 2px solid transparent;
				border-color: var(--color-teal);
				box-shadow: 0 0 0 3px var(--color-brand-ring);
			}

			.site-search :global(.site-search-results) {
				top: calc(100% + 8px);
				inset-inline: auto 0;
				width: max(100%, 380px);
				margin-top: 0;
				padding: 6px;
				border: 0;
				border-radius: 14px;
				background: var(--color-surface);
				box-shadow: var(--shadow-lg);
				max-height: min(420px, 70vh);
				overflow-y: auto;
				z-index: 60;
			}

			.site-search :global(.emdash-live-search-loading),
			.site-search :global(.emdash-live-search-no-results) {
				padding: var(--spacing-4);
				text-align: center;
				color: var(--color-muted);
				font-size: var(--font-size-sm);
			}

			.site-search :global(.site-search-result) {
				display: grid;
				gap: 2px;
				padding: 10px 12px;
				border: 0;
				border-radius: var(--radius);
				color: var(--color-text);
				text-decoration: none;
			}

			.site-search :global(.site-search-result):hover,
			.site-search :global(.site-search-result):focus,
			.site-search :global(.site-search-result.focused) {
				background: var(--color-fill);
				outline: 2px solid transparent;
				outline-offset: -2px;
			}

			.site-search :global(.emdash-live-search-result-title) {
				order: 1;
				font-size: var(--font-size-sm);
				font-weight: 600;
			}

			/* The collection name ("posts" / "pages") is an internal label */
			.site-search :global(.emdash-live-search-result-collection) {
				display: none;
			}

			.site-search :global(.emdash-live-search-result-snippet) {
				order: 2;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				font-size: var(--font-size-xs);
				line-height: var(--leading-snug);
				color: var(--color-text-secondary);
			}

			.site-search :global(.emdash-live-search-result-snippet mark) {
				padding: 0 2px;
				border-radius: 3px;
				background: var(--color-teal-pale);
				color: var(--color-text);
			}

			.site-search-link {
				display: none;
			}

			/* Footer: off-white band, three columns */
			.site-footer {
				margin-top: var(--spacing-16);
				background: var(--color-offwhite);
				border-top: 1px solid var(--color-border);
			}

			/* A page that ends in a full-bleed CTA band sits flush on the footer */
			:global(main:has(> .cta-band:last-child)) + .site-footer {
				margin-top: 0;
			}

			.site-footer__grid {
				display: grid;
				grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr));
				gap: var(--spacing-10);
				padding-block: var(--spacing-12) var(--spacing-10);
			}

			.site-footer__tagline {
				margin-top: var(--spacing-3);
				max-width: 30em;
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
			}

			.site-footer__operator {
				margin-top: var(--spacing-3);
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
			}

			.site-footer__operator a {
				color: inherit;
			}

			.site-footer__heading {
				margin-bottom: var(--spacing-4);
				font-size: var(--font-size-sm);
				font-weight: 700;
				letter-spacing: var(--tracking-wide);
				color: var(--color-navy);
			}

			.site-footer__links {
				display: grid;
				gap: var(--spacing-3);
				list-style: none;
			}

			.site-footer__links a {
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
				text-decoration: none;
			}

			.site-footer__links a:hover {
				color: var(--color-brand);
				text-decoration: underline;
			}

			.site-footer__bottom {
				border-top: 1px solid var(--color-border);
			}

			.site-footer__bottom-inner {
				padding-block: var(--spacing-5);
			}

			.site-footer__meta {
				font-size: var(--font-size-xs);
				color: var(--color-muted);
			}

			@media (forced-colors: active) {
				.site-nav a[aria-current] {
					border: 1px solid CanvasText;
				}
			}

			@media (max-width: 900px) {
				.site-search {
					display: none;
				}

				.site-search-link {
					display: inline-grid;
					width: 2.5rem;
					height: 2.5rem;
				}
			}

			@media (max-width: 760px) {
				.site-footer__grid {
					grid-template-columns: minmax(0, 1fr);
					gap: var(--spacing-8);
					padding-block: var(--spacing-10) var(--spacing-8);
				}
			}

			/* Phones: smaller brand and button so the first row fits */
			@media (max-width: 640px) {
				.site-header__inner {
					gap: var(--spacing-2);
					min-height: 58px;
					padding-block: 8px;
				}

				.brand {
					gap: 8px;
				}

				.brand__mark {
					width: 32px;
					height: 32px;
					border-radius: 9px;
				}

				.brand__mark svg {
					width: 20px;
					height: 20px;
				}

				.brand__name {
					font-size: 1rem;
					letter-spacing: 0.02em;
				}

				.brand__tagline {
					display: none;
				}

				.header-cta {
					padding: 8px 12px;
					font-size: 0.75rem;
				}

				.header-cta svg {
					display: none;
				}

				.site-search-link {
					width: 2.25rem;
					height: 2.25rem;
				}

				.nav-admin {
					display: none;
				}

				.site-nav a {
					height: 42px;
					padding: 0 10px;
					font-size: 0.8125rem;
				}

				.site-nav a::after {
					inset: auto 10px 0;
				}

				.site-nav__list {
					margin: 0 -10px;
				}
			}

			@media (max-width: 380px) {
				.brand__name {
					font-size: 0.9rem;
					letter-spacing: 0;
				}
			}
		</style>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
