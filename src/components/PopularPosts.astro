---
/** 記事ページの右の列などの記事リスト（人気記事・おすすめ記事）。ranked で順位の番号を付ける */
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	posts: ContentEntry<InferCollectionData<"posts">>[];
	class?: string;
	title?: string;
	ranked?: boolean;
}

const { posts, class: className, title = "人気記事", ranked = true } = Astro.props;
---

{
	posts.length > 0 && (
		<section class:list={["popular", className]}>
			<h2 class="popular__title">{title}</h2>
			<ol class="popular__list">
				{posts.map((p, i) => {
					const category = p.data.terms?.category?.[0] ?? null;
					return (
						<li class="popular__item">
							<a href={`/business/${p.id}/`} class="popular__link">
								<span class="popular__thumb">
									{p.data.featured_image && (
										<Image image={p.data.featured_image} sizes="(min-width: 1100px) 300px, 92vw" />
									)}
									{ranked && (
										<span class:list={["popular__rank", `popular__rank--${i + 1}`]}>{i + 1}</span>
									)}
								</span>
								<span class="popular__body">
									<span class="popular__name">{p.data.title}</span>
									{category && <span class="popular__cat">{category.label}</span>}
								</span>
							</a>
						</li>
					);
				})}
			</ol>
		</section>
	)
}

<style>
	/* 枠なし。画像を列の幅いっぱいに、その下にタイトル */
	.popular__title {
		margin: 0 0 1rem;
		padding-inline-start: 0.625rem;
		border-inline-start: 4px solid var(--color-teal);
		font-size: 1.0625rem;
		font-weight: 700;
		line-height: 1.4;
		color: var(--color-navy);
	}

	.popular__list {
		display: grid;
		gap: 1.375rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.popular__link {
		display: grid;
		gap: 0.625rem;
		color: inherit;
		text-decoration: none;
	}

	.popular__thumb {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 1200 / 630;
		border-radius: 8px;
		background: var(--color-fill);
		box-shadow: 0 1px 6px rgb(0 47 87 / 0.12);
	}

	.popular__thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.25s;
	}

	.popular__link:hover .popular__thumb :global(img) {
		transform: scale(1.03);
	}

	.popular__rank {
		position: absolute;
		top: 0;
		left: 0;
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		background: #8a99a6;
		color: #fff;
		font-size: 14px;
		font-weight: 700;
		line-height: 1;
	}

	.popular__rank--1 {
		background: linear-gradient(135deg, #e6b422, #f7d55c);
	}

	.popular__rank--2 {
		background: linear-gradient(135deg, #9aa3ab, #c9d0d6);
	}

	.popular__rank--3 {
		background: linear-gradient(135deg, #b2702f, #d89a5a);
	}

	.popular__body {
		display: grid;
		gap: 0.25rem;
	}

	.popular__name {
		font-size: 0.9375rem;
		font-weight: 700;
		line-height: 1.55;
		color: var(--color-navy);
	}

	.popular__link:hover .popular__name {
		color: var(--color-teal-dark);
	}

	.popular__cat {
		font-size: 0.75rem;
		color: var(--color-muted);
	}
</style>
