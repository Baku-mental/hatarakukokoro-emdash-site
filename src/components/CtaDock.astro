---
/**
 * スマホ・タブレットの記事ページで、画面の下に出る細い申し込みバー。
 * しつこくならないように: 本文を少し読み進めてから出す、本文中の CTA・バナー・フッターが見えている間は隠す、
 * × で閉じたらその回の訪問（タブを閉じるまで）は出さない。パソコン（右の列がある幅）では出さない
 */
import { LINKS } from "../site-config";
---

<div class="cta-dock" data-cta-dock hidden>
	<a href={LINKS.diagnosis} class="cta-dock__link" target="_blank" rel="noopener">
		<span class="cta-dock__label">人事・総務の方へ</span>
		<span class="cta-dock__title">無料の組織診断ではじめる</span>
	</a>
	<button type="button" class="cta-dock__close" data-cta-dock-close aria-label="閉じる">
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
	</button>
</div>

<script>
	const dock = document.querySelector<HTMLElement>("[data-cta-dock]");
	const KEY = "hk-cta-dock-closed";
	let closed = false;
	try {
		closed = sessionStorage.getItem(KEY) === "1";
	} catch {}

	if (dock && !closed && window.matchMedia("(max-width: 1099.98px)").matches) {
		// 本文の最初の見出し（H2）を過ぎたら出す
		const start = document.querySelector(".post-main h2");
		// これらが画面に見えている間は隠す（本文中の CTA と重ねない）
		const blockers = document.querySelectorAll(".k-cta-mid, .k-cta-foot, .banner--inline, .site-footer");
		let started = !start;
		const visible = new Set<Element>();

		const update = () => {
			dock.hidden = closed || !started || visible.size > 0;
		};

		if (start) {
			new IntersectionObserver((entries) => {
				for (const e of entries) {
					// 見出しが画面の上に出ていったら「読み始めた」とみなす
					if (!e.isIntersecting && e.boundingClientRect.top < 0) started = true;
				}
				update();
			}).observe(start);
		}

		const io = new IntersectionObserver((entries) => {
			for (const e of entries) {
				if (e.isIntersecting) visible.add(e.target);
				else visible.delete(e.target);
			}
			update();
		});
		blockers.forEach((el) => io.observe(el));

		dock.querySelector("[data-cta-dock-close]")?.addEventListener("click", () => {
			closed = true;
			try {
				sessionStorage.setItem(KEY, "1");
			} catch {}
			update();
		});
	}
</script>

<style>
	.cta-dock {
		position: fixed;
		inset-inline: var(--spacing-3);
		bottom: calc(var(--spacing-3) + env(safe-area-inset-bottom, 0px));
		z-index: 40;
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		padding: var(--spacing-2) var(--spacing-2) var(--spacing-2) var(--spacing-4);
		border-radius: 999px;
		background: var(--color-navy);
		box-shadow: 0 6px 20px rgb(0 47 87 / 0.25);
		color: #ffffff;
	}

	.cta-dock[hidden] {
		display: none;
	}

	.cta-dock__link {
		flex: 1;
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding-block: var(--spacing-1);
		color: #ffffff;
		text-decoration: none;
	}

	.cta-dock__label {
		font-size: 0.7rem;
		color: #dbe6ee;
	}

	.cta-dock__title {
		font-size: 0.95rem;
		font-weight: 700;
	}

	.cta-dock__title::after {
		content: " →";
		color: var(--color-teal-pale);
	}

	.cta-dock__close {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: #dbe6ee;
		cursor: pointer;
	}

	.cta-dock__close svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	@media (min-width: 1100px) {
		.cta-dock {
			display: none !important;
		}
	}
</style>
