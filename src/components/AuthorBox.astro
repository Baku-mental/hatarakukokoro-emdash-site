---
/** 記事の下の「この記事を書いた人」。中身は site-config.ts の EDITORIAL */
import { EDITORIAL } from "../site-config";
---

<section class="author" aria-labelledby="author-title">
	<h2 id="author-title" class="author__title">この記事を書いた人</h2>
	<div class="author__box">
		<div class="author__who">
			<img
				src={EDITORIAL.avatar}
				alt=""
				width="100"
				height="100"
				loading="lazy"
				decoding="async"
				class="author__avatar"
			/>
			<a href={EDITORIAL.url} class="author__name">{EDITORIAL.name}</a>
			<span class="author__position">{EDITORIAL.position}</span>
		</div>
		<div class="author__desc">
			{EDITORIAL.description.map((text) => <p>{text}</p>)}
		</div>
	</div>
</section>

<style>
	.author {
		margin-block-start: 3.5rem;
	}

	.author__title {
		margin-block-end: 1.25rem;
		padding-inline-start: 0.75rem;
		border-inline-start: 4px solid var(--color-teal);
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.4;
		color: var(--color-navy);
	}

	.author__box {
		display: grid;
		grid-template-columns: 11rem minmax(0, 1fr);
		gap: 1.5rem;
		padding: 1.75rem;
		border: 1px solid var(--color-border);
		border-radius: 14px;
	}

	.author__who {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.375rem;
		padding-inline-end: 1.5rem;
		border-inline-end: 1px solid var(--color-border);
		text-align: center;
	}

	.author__avatar {
		width: 100px;
		height: 100px;
		margin-block-end: 0.5rem;
		border: 3px solid var(--color-border);
		border-radius: 50%;
	}

	.author__name {
		font-weight: 700;
		line-height: 1.45;
		color: var(--color-navy);
		text-decoration: none;
	}

	.author__name:hover {
		color: var(--color-teal-dark);
	}

	.author__position {
		font-size: 0.8125rem;
		color: var(--color-text-secondary);
	}

	.author__desc {
		font-size: 0.9375rem;
		line-height: 1.85;
		color: var(--color-text-secondary);
	}

	.author__desc p + p {
		margin-block-start: 0.5rem;
	}

	@media (max-width: 640px) {
		.author__box {
			grid-template-columns: minmax(0, 1fr);
			padding: 1.25rem;
		}

		.author__who {
			padding-inline-end: 0;
			padding-block-end: 1rem;
			border-inline-end: 0;
			border-block-end: 1px solid var(--color-border);
		}
	}
</style>
