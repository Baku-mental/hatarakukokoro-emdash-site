---
/**
 * Breadcrumb trail shared by every page. "ホーム" is added in front; the last
 * item is the current page and is not linked. Also emits schema.org
 * BreadcrumbList JSON-LD so search results can show the trail.
 *
 * Pages on a light hero set --crumb-color / --crumb-sep on the parent to keep
 * fixed colors there.
 */
interface Crumb {
	label: string;
	/** Omit for the current page. */
	href?: string;
}

interface Props {
	items: Crumb[];
}

const trail: Crumb[] = [{ label: "ホーム", href: "/business/" }, ...Astro.props.items];

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: trail.map((crumb, index) => ({
		"@type": "ListItem",
		position: index + 1,
		name: crumb.label,
		...(crumb.href ? { item: new URL(crumb.href, Astro.url).href } : {}),
	})),
};
---

<nav class="crumbs" aria-label="パンくずリスト">
	<ol>
		{
			trail.map((crumb, index) => (
				<li>
					{index > 0 && <span class="crumbs__sep" aria-hidden="true">&gt;</span>}
					{crumb.href && index < trail.length - 1 ? (
						<a href={crumb.href}>{crumb.label}</a>
					) : (
						<span aria-current="page">{crumb.label}</span>
					)}
				</li>
			))
		}
	</ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
	.crumbs {
		margin-block-end: var(--crumb-gap, 20px);
	}

	.crumbs ol {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 13px;
		line-height: 1.7;
		color: var(--crumb-color, var(--color-text-secondary));
	}

	.crumbs li {
		display: inline;
	}

	.crumbs a {
		color: inherit;
		text-decoration: none;
	}

	.crumbs a:hover {
		color: var(--color-teal);
		text-decoration: underline;
	}

	.crumbs__sep {
		margin-inline: 10px;
		color: var(--crumb-sep, var(--color-muted));
	}

	/* 記事タイトルなど長い現在地は1行で省略 */
	.crumbs [aria-current="page"] {
		display: inline-block;
		max-width: 32em;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		vertical-align: bottom;
	}

	@media (max-width: 640px) {
		.crumbs ol {
			font-size: 12px;
		}

		.crumbs__sep {
			margin-inline: 6px;
		}

		.crumbs [aria-current="page"] {
			max-width: 14em;
		}
	}
</style>
