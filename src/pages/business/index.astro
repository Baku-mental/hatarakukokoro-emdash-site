---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { CATEGORIES, LINKS } from "../../site-config";
import { formatShortDate } from "../../utils/locale";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { legacyWpPath } from "../../utils/wp-legacy";

/*
 * Top page. The Worker runs on the Cloudflare free plan (10 ms CPU per
 * request), so the page makes ONE posts query and reuses it for both the
 * hero's 3 newest titles and the 8 article cards. No per-post term or
 * byline queries: categories come hydrated on the entries.
 */
// WordPress 時代の URL（/business/?p=番号 など）は新しい URL へ移動。末尾の「/」も付ける
if (Astro.url.search) {
	const legacy = legacyWpPath(Astro.url.searchParams);
	if (legacy) return Astro.redirect(legacy, 301);
}
if (!Astro.url.pathname.endsWith("/")) return Astro.redirect("/business/", 301);

const POSTS_ON_HOME = 8;

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_ON_HOME,
	}),
	getSiteSettings(),
]);
const { siteTitle } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const latest = posts.slice(0, 3);

/** External (imported WordPress) images carry their URL in `src`. */
function externalSrc(image: unknown): string | null {
	if (!image || typeof image !== "object") return null;
	const src = (image as { src?: unknown }).src;
	return typeof src === "string" && src ? src : null;
}

function imageAlt(image: unknown): string {
	if (!image || typeof image !== "object") return "";
	const alt = (image as { alt?: unknown }).alt;
	return typeof alt === "string" ? alt : "";
}
---

<Base
	title={siteTitle}
	description="職場のメンタルヘルスを、産業保健の担当者がいない会社のために。ストレスチェックから休職・復職、ハラスメント対策、ラインケアまで、50人未満の会社の実務にあわせてまとめています。"
>
	<section class="home-hero">
		<div class="frame home-hero__grid">
			<div class="home-hero__text">
				<h1 class="home-hero__title">
					<span>職場のメンタルヘルスを、</span>
					<span>産業保健の担当者がいない会社のために</span>
				</h1>
				<p class="home-hero__lead">
					ストレスチェック、休職・復職、ハラスメント対策、部下への声かけまで。担当者がすぐに使える手順・例文や、研修内容・チェックリストをまとめています。
				</p>
				<div class="home-hero__actions">
					<a
						href={LINKS.diagnosis}
						class="btn home-btn home-btn--primary"
						target="_blank"
						rel="noopener"
					>
						無料の組織診断
					</a>
					<a
						href={LINKS.download}
						class="btn home-btn home-btn--outline"
						target="_blank"
						rel="noopener"
					>
						資料をダウンロード
					</a>
				</div>
			</div>
			{
				latest.length > 0 && (
					<div class="home-latest">
						<h2 class="home-latest__title">新着記事</h2>
						<ol class="home-latest__list">
							{latest.map((post) => (
								<li>
									<a href={`/business/${post.id}/`}>{post.data.title || "無題"}</a>
								</li>
							))}
						</ol>
					</div>
				)
			}
		</div>
	</section>

	<section class="home-section" aria-labelledby="home-categories">
		<div class="frame">
			<h2 id="home-categories" class="home-section__title">
				人気カテゴリから探す
			</h2>
			<ul class="home-pills">
				{
					CATEGORIES.map((category) => (
						<li>
							<a href={`/business/category/${category.slug}/`} class="home-pill">
								{category.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="home-section" aria-labelledby="home-articles">
		<div class="frame">
			<div class="home-section__head">
				<h2 id="home-articles" class="home-section__title">新着記事</h2>
				<span class="home-section__sub" lang="en">Articles</span>
			</div>
			{
				posts.length === 0 ? (
					<p class="home-empty">記事を準備しています。</p>
				) : (
					<ul class="home-cards">
						{posts.map((post, index) => {
							const href = `/business/${post.id}/`;
							const image = post.data.featured_image;
							const src = externalSrc(image);
							const publishedAt = post.data.publishedAt ?? null;
							return (
								<li class="home-card">
									<a href={href} class="home-card__link">
										<span class="home-card__media">
											{src ? (
												<img
													src={src}
													alt={imageAlt(image)}
													loading={index < 4 ? "eager" : "lazy"}
													decoding="async"
													width="1200"
													height="630"
												/>
											) : image ? (
												<Image image={image} sizes="(min-width: 1080px) 280px, (min-width: 640px) 45vw, 100vw" />
											) : (
												<span class="home-card__placeholder" aria-hidden="true" />
											)}
										</span>
										<span class="home-card__body">
											{publishedAt && (
												<time class="home-card__date" datetime={publishedAt.toISOString()}>
													{formatShortDate(publishedAt)}
												</time>
											)}
											<span class="home-card__title">{post.data.title || "無題"}</span>
										</span>
									</a>
								</li>
							);
						})}
					</ul>
				)
			}
			<div class="home-more">
				<a href="/business/posts/" class="arrow-link">
					記事一覧へ
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M5 12h14"></path>
						<path d="m12 5 7 7-7 7"></path>
					</svg>
				</a>
			</div>
		</div>
	</section>

	<section class="cta-band" aria-labelledby="home-cta">
		<div class="frame cta-band__inner">
			<h2 id="home-cta" class="cta-band__title">無料の組織診断</h2>
			<p class="cta-band__text">
				設問に答えるだけで、組織の状態と部署ごとの傾向がわかります。導入の検討前に、まず自社の状態を見るところから使えます。
			</p>
			<a
				href={LINKS.diagnosis}
				class="btn home-btn cta-band__btn"
				target="_blank"
				rel="noopener"
			>
				無料ではじめる
			</a>
		</div>
	</section>
</Base>

<style>
	/* Hero */
	.home-hero {
		background: var(--color-teal-bg);
		padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
	}

	.home-hero__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		align-items: center;
		gap: var(--spacing-10);
	}

	.home-hero__text {
		container-type: inline-size;
	}

	/* 見出しは2行に収める: 2行目（18字）が列の幅に入る大きさまで文字を縮める */
	.home-hero__title {
		font-size: max(1.25rem, min(2.25rem, 100cqi / 19.2));
		line-height: 1.5;
		letter-spacing: 0.04em;
		color: var(--color-navy);
		text-wrap: wrap;
	}

	.home-hero__title span {
		display: block;
	}

	@media (min-width: 420px) {
		.home-hero__title span {
			white-space: nowrap;
		}
	}

	.home-hero__lead {
		margin-top: var(--spacing-5);
		max-width: 36em;
		font-size: var(--font-size-base);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
	}

	.home-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
		margin-top: var(--spacing-8);
	}

	.home-btn {
		min-height: 3rem;
		padding-inline: var(--spacing-6);
		font-size: var(--font-size-base);
		font-weight: 700;
	}

	.home-btn--primary {
		background: var(--color-teal);
		color: #ffffff;
	}

	.home-btn--primary:hover {
		background: var(--color-teal-dark);
	}

	.home-btn--outline {
		background: #ffffff;
		color: var(--color-teal-dark);
		box-shadow: inset 0 0 0 2px var(--color-teal);
	}

	.home-btn--outline:hover {
		background: var(--color-teal-pale);
	}

	/* 新着記事 box in the hero */
	.home-latest {
		padding: var(--spacing-6);
		border-radius: var(--radius-xl);
		background: #ffffff;
		box-shadow: var(--shadow-card);
	}

	.home-latest__title {
		padding-bottom: var(--spacing-3);
		border-bottom: 2px solid var(--color-teal-pale);
		font-size: var(--font-size-base);
		color: var(--color-navy);
	}

	.home-latest__list {
		counter-reset: latest;
		display: grid;
		list-style: none;
	}

	.home-latest__list li {
		counter-increment: latest;
		display: grid;
		grid-template-columns: 1.75rem minmax(0, 1fr);
		gap: var(--spacing-2);
		padding-block: var(--spacing-3);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.home-latest__list li:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.home-latest__list li::before {
		content: counter(latest);
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		margin-top: 0.15rem;
		border-radius: var(--radius-full);
		background: var(--color-teal);
		color: #ffffff;
		font-size: var(--font-size-xs);
		font-weight: 700;
		line-height: 1;
	}

	.home-latest__list a {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: var(--font-size-sm);
		font-weight: 600;
		line-height: var(--leading-snug);
		color: var(--color-text);
		text-decoration: none;
	}

	.home-latest__list a:hover {
		color: var(--color-brand);
		text-decoration: underline;
	}

	/* Sections */
	.home-section {
		padding-block: clamp(2.5rem, 1.75rem + 2.5vw, 4rem) 0;
	}

	.home-section__head {
		display: flex;
		align-items: baseline;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-6);
	}

	.home-section__title {
		position: relative;
		padding-inline-start: var(--spacing-4);
		font-size: var(--font-size-xl);
		color: var(--color-navy);
	}

	.home-section__title::before {
		content: "";
		position: absolute;
		inset-block: 0.2em;
		inset-inline-start: 0;
		width: 4px;
		border-radius: 2px;
		background: var(--color-teal);
	}

	.home-section > .frame > .home-section__title {
		margin-bottom: var(--spacing-5);
	}

	.home-section__sub {
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: var(--tracking-wider);
		color: var(--color-teal);
	}

	/* Category pills */
	.home-pills {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
		list-style: none;
	}

	.home-pill {
		display: inline-block;
		padding: var(--spacing-2) var(--spacing-5);
		border-radius: var(--radius-full);
		background: var(--color-teal-pale);
		color: var(--color-navy);
		font-size: var(--font-size-sm);
		font-weight: 600;
		text-decoration: none;
		transition:
			background-color var(--transition-fast),
			color var(--transition-fast);
	}

	.home-pill:hover {
		background: var(--color-teal);
		color: #ffffff;
	}

	/* Article cards: 4 / 2 / 1 columns */
	.home-cards {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--spacing-6) var(--spacing-5);
		list-style: none;
	}

	.home-card__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
		color: inherit;
		text-decoration: none;
		transition: box-shadow var(--transition-base);
	}

	.home-card__link:hover {
		box-shadow: var(--shadow-card-hover);
	}

	.home-card__media {
		position: relative;
		display: block;
		aspect-ratio: 1200 / 630;
		overflow: hidden;
		background: var(--color-fill);
	}

	.home-card__media :global(img) {
		width: 100%;
		max-width: none;
		height: 100%;
		object-fit: cover;
	}

	.home-card__placeholder {
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, var(--color-teal-bg), var(--color-teal-pale));
	}

	.home-card__body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
		padding: var(--spacing-3) var(--spacing-4) var(--spacing-4);
	}

	.home-card__date {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	.home-card__title {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: var(--font-size-sm);
		font-weight: 700;
		line-height: var(--leading-snug);
		color: var(--color-text);
	}

	.home-card__link:hover .home-card__title {
		color: var(--color-brand);
	}

	.home-empty {
		color: var(--color-text-secondary);
	}

	.home-more {
		display: flex;
		justify-content: center;
		margin-top: var(--spacing-8);
	}

	.home-more .arrow-link {
		font-size: var(--font-size-base);
	}

	/* CTA band */
	.cta-band {
		margin-top: clamp(3rem, 2rem + 3vw, 5rem);
		padding-block: clamp(2.5rem, 1.75rem + 3vw, 4rem);
		background: var(--color-navy);
		color: #ffffff;
	}

	.cta-band__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.cta-band__title {
		font-size: clamp(1.35rem, 1.1rem + 1vw, 1.75rem);
		color: #ffffff;
	}

	.cta-band__text {
		margin-top: var(--spacing-4);
		max-width: 36em;
		color: #dbe6ee;
	}

	.cta-band__btn {
		margin-top: var(--spacing-6);
		background: var(--color-teal);
		color: #ffffff;
	}

	.cta-band__btn:hover {
		background: var(--color-teal-dark);
	}

	@media (max-width: 1023.98px) {
		.home-cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 860px) {
		.home-hero__grid {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--spacing-8);
		}
	}

	@media (max-width: 639.98px) {
		.home-cards {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-hero__actions .home-btn {
			flex: 1 1 100%;
		}

		.home-latest {
			padding: var(--spacing-5);
		}
	}
</style>
