---
/**
 * こころ研修ナビ（/business/kenshu/）。公認心理師による研修を探して相談する一覧ページ。
 * 研修は CMS の「研修」（trainings）。カードはページの HTML に入れて（検索エンジン向け）、
 * 絞り込みはブラウザで行う。相談は Google フォーム（site-config.ts の KENSHU）。
 */
import { getEmDashCollection } from "emdash";
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { KENSHU } from "../../../site-config";

if (!Astro.url.pathname.endsWith("/")) return Astro.redirect(KENSHU.path, 301);

const CATEGORIES = [
	"セルフケア",
	"ラインケア・マネジメント",
	"コミュニケーション",
	"ハラスメント対策",
	"人事・制度対応",
	"働き方・ライフイベント",
];
const AUDIENCES = [
	{ value: "全職員", label: "全職員・全従業員" },
	{ value: "新入社員・若手", label: "新入社員・若手" },
	{ value: "管理職", label: "管理職・リーダー" },
	{ value: "人事・保健", label: "人事・産業保健担当" },
];
const QUICK = ["ラインケア", "セルフケア", "ハラスメント", "1on1", "心理的安全性", "ストレスチェック"];

const { entries, cacheHint } = await getEmDashCollection("trainings", {
	orderBy: { published_at: "desc" },
	limit: 500,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const list = (v: unknown): string[] =>
	Array.isArray(v) ? v.map(String) : typeof v === "string" && v ? [v] : [];

const trainings = entries.map((e, i) => {
	const d = e.data as Record<string, unknown>;
	const themes = String(d.themes ?? "")
		.split(/[、,，]/)
		.map((s) => s.trim())
		.filter(Boolean);
	return {
		id: e.id,
		order: i,
		title: String(d.title ?? ""),
		category: String(d.category ?? ""),
		targets: list(d.targets),
		audience: list(d.audience),
		formats: list(d.formats),
		minutes: Number(d.minutes ?? 0),
		people: String(d.people ?? ""),
		price: d.price == null || d.price === "" ? null : Number(d.price),
		summary: String(d.summary ?? ""),
		themes,
		sample: !!d.is_sample,
		// 研修でやること: 1行に1つ（「分|内容」の形なら分も出す）
		program: String(d.program ?? "")
			.split(/\r?\n/)
			.map((line) => line.trim())
			.filter(Boolean)
			.map((line) => {
				const m = line.match(/^(\d+)\s*[|｜]\s*(.+)$/);
				return m ? { min: Number(m[1]), text: m[2] } : { min: null, text: line };
			}),
	};
});

// ご相談から実施までの流れ
const STEPS = [
	{ title: "フォームで相談", text: "気になる研修、受講者、時期、課題などをフォームから送ってください。研修が決まっていなくてもかまいません。" },
	{ title: "打ち合わせ", text: "担当者からご連絡し、オンラインで課題や受講者の状況、日程をうかがいます。" },
	{ title: "内容と費用の確定", text: "組織の状況にあわせて内容や時間を調整し、費用と実施の形をご提案します。" },
	{ title: "研修の実施", text: "公認心理師の講師が、対面またはオンラインで研修を行います。" },
];

const yen = (n: number | null) => (n == null ? "要相談" : `${n.toLocaleString("ja-JP")}円`);

function formLink(title: string): string | null {
	if (!KENSHU.formUrl) return null;
	if (!KENSHU.prefillEntry) return KENSHU.formUrl;
	const u = new URL(KENSHU.formUrl);
	u.searchParams.set("usp", "pp_url");
	u.searchParams.set(KENSHU.prefillEntry, title);
	return u.toString();
}
const providerLink = formLink("【講師掲載の相談】");

const title = "こころ研修ナビ｜公認心理師によるメンタルヘルス研修を探す";
const description =
	"管理職向けのラインケア、全員向けのセルフケア、ハラスメント対策、1on1や心理的安全性まで。公認心理師による職場のメンタルヘルス研修を、テーマ・受講者・形式で比較して相談できます。";
---

<Base title={title} description={description}>
	<div class="crumb-band">
		<div class="frame">
			<Breadcrumbs items={[{ label: "こころ研修ナビ" }]} />
		</div>
	</div>

	<section class="kn-hero">
		<div class="frame">
			<p class="kn-hero__brand">こころ研修ナビ</p>
			<h1 class="kn-hero__title">
				職員・従業員のメンタルヘルス研修を、<br /><em>心理の専門家</em>から選ぶ。
			</h1>
			<p class="kn-hero__lead">
				管理職向けのラインケアから、全員向けのセルフケア、ハラスメント対策、1on1や心理的安全性まで。国家資格を持つ公認心理師による研修を、テーマ・受講者・形式で比較して相談できます。
			</p>
			<p class="kn-hero__badge">講師はすべて<b>公認心理師</b>（心理職唯一の国家資格）</p>
			<form class="kn-search" role="search" data-kn-search>
				<input
					type="search"
					placeholder="例：ラインケア、1on1、アンガーマネジメント"
					aria-label="キーワードで探す"
					data-kn-q
				/>
				<button type="submit">検索</button>
			</form>
			<div class="kn-quick">
				<span>よく探されるテーマ</span>
				{QUICK.map((q) => <button type="button" data-kn-quick={q}>{q}</button>)}
			</div>
		</div>
	</section>

	<div class="frame kn-main" id="list">
		<aside class="kn-filters" data-kn-filters>
			<fieldset>
				<legend>対象</legend>
				<label><input type="checkbox" name="target" value="自治体" /> 自治体・官公庁</label>
				<label><input type="checkbox" name="target" value="企業" /> 企業</label>
			</fieldset>
			<fieldset>
				<legend>テーマ</legend>
				{CATEGORIES.map((c) => <label><input type="checkbox" name="cat" value={c} /> {c}</label>)}
			</fieldset>
			<fieldset>
				<legend>受講者</legend>
				{AUDIENCES.map((a) => <label><input type="checkbox" name="audience" value={a.value} /> {a.label}</label>)}
			</fieldset>
			<fieldset>
				<legend>形式</legend>
				<label><input type="checkbox" name="format" value="対面" /> 対面</label>
				<label><input type="checkbox" name="format" value="オンライン" /> オンライン</label>
			</fieldset>
			<fieldset>
				<legend>時間</legend>
				<label><input type="radio" name="dur" value="0" checked /> 指定なし</label>
				<label><input type="radio" name="dur" value="60" /> 60分以内</label>
				<label><input type="radio" name="dur" value="120" /> 120分以内</label>
			</fieldset>
			<button type="button" class="kn-reset" data-kn-reset>条件をクリア</button>
		</aside>

		<section class="kn-results" aria-labelledby="kn-count-label">
			<div class="kn-bar">
				<p id="kn-count-label"><strong data-kn-count>{trainings.length}</strong> 件の研修</p>
				<select aria-label="並び替え" data-kn-sort>
					<option value="new">新着順</option>
					<option value="short">時間が短い順</option>
				</select>
			</div>

			<div class="kn-cards" data-kn-cards>
				{
					trainings.map((t) => {
						const href = formLink(t.title);
						return (
							<article
								class="kn-card"
								data-order={t.order}
								data-minutes={t.minutes}
								data-cat={t.category}
								data-targets={t.targets.join("|")}
								data-audience={t.audience.join("|")}
								data-formats={t.formats.join("|")}
								data-text={[t.title, t.summary, t.category, ...t.themes].join(" ").toLowerCase()}
							>
								<div class="kn-tags">
									{t.targets.includes("企業") && <span class="kn-tag kn-tag--corp">企業向け</span>}
									{t.targets.includes("自治体") && <span class="kn-tag kn-tag--gov">自治体向け</span>}
									{t.themes.map((th) => <span class="kn-tag">{th}</span>)}
								</div>
								<h2 class="kn-card__title">{t.title}</h2>
								{t.summary && <p class="kn-card__summary">{t.summary}</p>}
								{t.program.length > 0 && (
									<details class="kn-program">
										<summary>研修でやること</summary>
										<ol>
											{t.program.map((step) => (
												<li>
													{step.min != null && <span class="kn-program__min">{step.min}分</span>}
													<span>{step.text}</span>
												</li>
											))}
										</ol>
										<p class="kn-program__note">内容と時間は、組織の状況にあわせて調整できます。</p>
									</details>
								)}
								<dl class="kn-meta">
									<div><dt>時間</dt><dd>{t.minutes}分</dd></div>
									<div><dt>形式</dt><dd>{t.formats.join("／") || "要相談"}</dd></div>
									<div><dt>人数目安</dt><dd>{t.people || "要相談"}</dd></div>
									<div><dt>費用</dt><dd>{yen(t.price)}</dd></div>
								</dl>
								<div class="kn-card__foot">
									{href ? (
										<a class="kn-btn kn-btn--ghost" href={href} target="_blank" rel="noopener">
											この研修を相談する
										</a>
									) : (
										<span class="kn-btn kn-btn--off">相談の受付は準備中です</span>
									)}
								</div>
							</article>
						);
					})
				}
			</div>
			<p class="kn-empty" data-kn-empty hidden>
				条件に合う研修が見つかりませんでした。条件を減らすか、別のキーワードでお試しください。
			</p>
		</section>
	</div>

	<section class="frame kn-steps" aria-labelledby="kn-steps-title">
		<h2 id="kn-steps-title">ご相談から実施までの流れ</h2>
		<ol>
			{STEPS.map((step, i) => (
				<li>
					<span class="kn-steps__num">{i + 1}</span>
					<h3>{step.title}</h3>
					<p>{step.text}</p>
				</li>
			))}
		</ol>
	</section>

	<section class="frame kn-provider" id="provider">
		<div>
			<h2>研修講師として掲載しませんか</h2>
			<p>
				公認心理師の資格をお持ちの方を対象に、研修プログラムの掲載を受け付けています。掲載の前に、運営（株式会社remental）が資格を確認します。自治体・企業からの相談はこのサイト経由で届きます。
			</p>
		</div>
		{
			providerLink ? (
				<a class="kn-btn" href={providerLink} target="_blank" rel="noopener">掲載について相談する</a>
			) : (
				<span class="kn-btn kn-btn--off">受付は準備中です</span>
			)
		}
	</section>

	<p class="frame kn-foot-note">運営：株式会社remental　｜　掲載情報は各講師の申告に基づきます。</p>
</Base>

<script>
	// 絞り込み（カードは HTML に入っているので、条件に合わないものを隠すだけ）
	const root = document;
	const q = root.querySelector<HTMLInputElement>("[data-kn-q]");
	const cardsBox = root.querySelector<HTMLElement>("[data-kn-cards]");
	const cards = [...root.querySelectorAll<HTMLElement>(".kn-card")];
	const countEl = root.querySelector("[data-kn-count]");
	const empty = root.querySelector<HTMLElement>("[data-kn-empty]");
	const sort = root.querySelector<HTMLSelectElement>("[data-kn-sort]");
	const checked = (name: string) =>
		[...root.querySelectorAll<HTMLInputElement>(`input[name=${name}]:checked`)].map((i) => i.value);
	const has = (el: HTMLElement, key: string, wanted: string[]) =>
		wanted.length === 0 || wanted.some((v) => (el.dataset[key] ?? "").split("|").includes(v));

	function render() {
		const text = (q?.value ?? "").trim().toLowerCase();
		const cat = checked("cat");
		const dur = Number(root.querySelector<HTMLInputElement>("input[name=dur]:checked")?.value ?? 0);
		let shown = 0;
		for (const el of cards) {
			const ok =
				(!text || (el.dataset.text ?? "").includes(text)) &&
				(cat.length === 0 || cat.includes(el.dataset.cat ?? "")) &&
				has(el, "targets", checked("target")) &&
				has(el, "audience", checked("audience")) &&
				has(el, "formats", checked("format")) &&
				(!dur || Number(el.dataset.minutes) <= dur);
			el.hidden = !ok;
			if (ok) shown++;
		}
		const key = sort?.value === "short" ? "minutes" : "order";
		[...cards]
			.sort((a, b) => Number(a.dataset[key]) - Number(b.dataset[key]))
			.forEach((el) => cardsBox?.appendChild(el));
		if (countEl) countEl.textContent = String(shown);
		if (empty) empty.hidden = shown > 0;
	}

	root.querySelector("[data-kn-search]")?.addEventListener("submit", (e) => {
		e.preventDefault();
		render();
	});
	q?.addEventListener("input", render);
	sort?.addEventListener("change", render);
	root.querySelectorAll("[data-kn-filters] input").forEach((i) => i.addEventListener("change", render));
	root.querySelectorAll<HTMLButtonElement>("[data-kn-quick]").forEach((b) =>
		b.addEventListener("click", () => {
			if (q) q.value = b.dataset.knQuick ?? "";
			render();
			document.getElementById("list")?.scrollIntoView({ behavior: "smooth" });
		}),
	);
	root.querySelector("[data-kn-reset]")?.addEventListener("click", () => {
		root.querySelectorAll<HTMLInputElement>("[data-kn-filters] input[type=checkbox]").forEach((i) => (i.checked = false));
		const any = root.querySelector<HTMLInputElement>("input[name=dur][value='0']");
		if (any) any.checked = true;
		if (q) q.value = "";
		render();
	});
</script>

<style>
	.crumb-band {
		padding-block: 0.625rem;
		border-block: 1px solid var(--color-border-subtle);
		background: #f6f8f8;
	}

	.crumb-band :global(.crumbs) {
		margin: 0;
	}

	.crumb-band :global(.crumbs ol) {
		font-size: 12px;
	}

	.kn-hero {
		padding-block: 2.5rem 2rem;
		background: linear-gradient(180deg, var(--color-teal-pale), #fff);
	}

	.kn-hero .frame {
		display: grid;
		gap: 0.875rem;
	}

	.kn-hero__brand {
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--color-teal-dark);
	}

	.kn-hero__brand::before {
		content: "";
		display: inline-block;
		width: 9px;
		height: 9px;
		margin-inline-end: 8px;
		border-radius: 50%;
		background: #efb03d;
		vertical-align: 1px;
	}

	.kn-hero__title {
		margin: 0;
		font-size: clamp(1.5rem, 1rem + 2.2vw, 2.25rem);
		font-weight: 800;
		line-height: 1.4;
		color: var(--color-navy);
	}

	.kn-hero__title em {
		font-style: normal;
		background: linear-gradient(transparent 62%, #fcebc6 62%);
	}

	.kn-hero__lead {
		max-width: 44em;
		color: var(--color-text-secondary);
	}

	.kn-hero__badge {
		justify-self: start;
		padding: 4px 14px;
		border-radius: 999px;
		background: #fcebc6;
		font-size: 0.8125rem;
		color: var(--color-navy);
	}

	.kn-search {
		display: flex;
		gap: 8px;
		max-width: 680px;
		margin-block-start: 0.5rem;
		padding: 6px;
		border: 1px solid var(--color-border);
		border-radius: 10px;
		background: #fff;
		box-shadow: 0 6px 20px -12px rgb(0 47 87 / 0.35);
	}

	.kn-search input {
		flex: 1;
		min-width: 0;
		padding: 10px 12px;
		border: 0;
		background: transparent;
		font: inherit;
		outline: none;
	}

	.kn-search button {
		padding: 0 18px;
		border: 0;
		border-radius: 7px;
		background: var(--color-teal);
		color: #fff;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}

	.kn-quick {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		font-size: 0.8125rem;
		color: var(--color-text-secondary);
	}

	.kn-quick button {
		padding: 3px 12px;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: #fff;
		color: var(--color-navy);
		font: inherit;
		cursor: pointer;
	}

	.kn-quick button:hover {
		border-color: #efb03d;
		background: #fcebc6;
	}

	.kn-main {
		display: grid;
		grid-template-columns: 220px minmax(0, 1fr);
		gap: 28px;
		align-items: start;
		padding-block: 1.5rem 3rem;
	}

	.kn-filters {
		position: sticky;
		top: calc(var(--nav-height, 4rem) + 1rem);
		display: grid;
		gap: 1.25rem;
	}

	.kn-filters fieldset {
		margin: 0;
		padding: 0;
		border: 0;
	}

	.kn-filters legend {
		margin-block-end: 0.5rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--color-text-secondary);
	}

	.kn-filters label {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 3px 0;
		font-size: 0.875rem;
		cursor: pointer;
	}

	.kn-filters input {
		width: 16px;
		height: 16px;
		accent-color: var(--color-teal);
	}

	.kn-reset {
		justify-self: start;
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-teal-dark);
		font: inherit;
		font-size: 0.8125rem;
		cursor: pointer;
	}

	.kn-results {
		display: grid;
		gap: 14px;
		min-width: 0;
	}

	.kn-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		font-size: 0.8125rem;
		color: var(--color-text-secondary);
	}

	.kn-bar strong {
		font-size: 1.125rem;
		color: var(--color-navy);
	}

	.kn-bar select {
		padding: 5px 8px;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		background: #fff;
		font: inherit;
	}

	.kn-cards {
		display: grid;
		gap: 14px;
	}

	.kn-card {
		display: grid;
		gap: 10px;
		padding: 18px 20px;
		border: 1px solid var(--color-border);
		border-radius: 10px;
		background: #fff;
		transition: border-color 0.15s;
	}

	.kn-card:hover {
		border-color: var(--color-teal);
	}

	.kn-card[hidden] {
		display: none;
	}

	.kn-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.kn-tag {
		padding: 2px 8px;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		font-size: 0.6875rem;
		color: var(--color-text-secondary);
	}

	.kn-tag--corp {
		border-color: transparent;
		background: #fdf1d8;
		color: #8a5e00;
		font-weight: 700;
	}

	.kn-tag--gov {
		border-color: transparent;
		background: var(--color-teal-pale);
		color: var(--color-navy);
		font-weight: 700;
	}

	.kn-card__title {
		margin: 0;
		font-size: 1.125rem;
		font-weight: 700;
		line-height: 1.5;
		color: var(--color-navy);
	}

	.kn-card__summary {
		font-size: 0.875rem;
		color: var(--color-text-secondary);
	}

	.kn-meta {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 8px;
		margin: 0;
		padding-block-start: 10px;
		border-block-start: 1px dashed var(--color-border);
	}

	.kn-meta dt {
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		color: var(--color-text-secondary);
	}

	.kn-meta dd {
		margin: 0;
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
	}

	.kn-card__foot {
		display: flex;
		justify-content: flex-end;
	}

	.kn-btn {
		display: inline-block;
		padding: 7px 16px;
		border: 1px solid var(--color-teal);
		border-radius: 7px;
		background: var(--color-teal);
		color: #fff;
		font-size: 0.875rem;
		font-weight: 700;
		text-decoration: none;
	}

	.kn-btn:hover {
		background: var(--color-teal-dark);
