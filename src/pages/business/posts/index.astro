---
import { getEmDashCollection } from "emdash";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Base from "../../../layouts/Base.astro";
import PostCard from "../../../components/PostCard.astro";
import Pagination from "../../../components/Pagination.astro";
import CtaBand from "../../../components/CtaBand.astro";

// Sort in the database rather than in JS — lets the DB use its index on
// published_at and avoids a full-table scan on the client.
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Tags and bylines are already hydrated onto each entry by
// getEmDashCollection, so no extra query is needed.
const postsWithTags = posts.map((post) => ({
	post,
	tags: post.data.terms?.tag ?? [],
}));
---

<Base
	title="記事一覧"
	description="はたらくこころ研究所の記事の一覧です。ストレスチェック、メンタルヘルス対策、休職・復職、ハラスメント対策、ラインケアなど、企業のメンタルヘルス実務の記事を新しい順に並べています。"
>
	<header class="band intro">
		<div class="frame">
			<Breadcrumbs items={[{ label: "記事一覧" }]} />
			<h1 class="intro__title">記事一覧</h1>
			<p class="intro__lead">企業のメンタルヘルス実務の記事を、新しい順に並べています。</p>
		</div>
	</header>

	<section class="band section archive-band">
		<div class="frame">
			{
				posts.length === 0 ? (
					<div class="empty-state">
						<h2 class="empty-state__title">
							{cursor ? "これより前の記事はありません" : "記事を準備しています"}
						</h2>
						<p class="empty-state__text">
							{cursor
								? "記事一覧の最後まで来ました。"
								: "公開した記事はここに並びます。"}
						</p>
						{cursor && (
							<div class="empty-state__actions">
								<a href="/business/posts/" class="btn btn--ghost">
									最初のページ
								</a>
							</div>
						)}
					</div>
				) : (
					<>
						<ol class="archive__list">
							{postsWithTags.map(({ post, tags }) => (
								<li>
									<PostCard post={post} tags={tags} variant="row" />
								</li>
							))}
						</ol>
						<Pagination
							basePath="/business/posts/"
							cursor={cursor}
							nextCursor={nextCursor}
						/>
					</>
				)
			}
		</div>
	</section>
	<CtaBand />
</Base>

<style>
	/* The band's rule doubles as the first row divider */
	.archive-band {
		padding-block-start: 0;
	}

	.archive__list {
		list-style: none;
	}

	.archive__list > li + li {
		border-block-start: 1px solid var(--color-border);
	}
</style>
