---
import {
	getEmDashEntry,
	getEmDashCollection,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
	getEditMeta,
} from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Byline from "../../components/Byline.astro";
import PostCard from "../../components/PostCard.astro";
import WpGroup from "../../components/WpGroup.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import SideBanner from "../../components/SideBanner.astro";
import { groupWpBlocks } from "../../utils/wp-groups";
import { formatDate } from "../../utils/locale";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

// 取り込んだ WordPress のトップ（固定ページ top）は新しいトップへ
if (slug === "top") return Astro.redirect("/business/", 301);

// 記事も固定ページも /business/<slug>/ で開く。末尾の「/」がなければ付けて移動
if (!Astro.url.pathname.endsWith("/")) {
	return Astro.redirect(`/business/${encodeURIComponent(slug)}/${Astro.url.search}`, 301);
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	// 同じ slug の記事がなければ固定ページを表示する（中身は pages/[slug].astro）
	return Astro.rewrite(`/pages/${encodeURIComponent(slug)}`);
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Get featured image URL for OG fallback
// The image may have src (external) or meta.storageKey (local)
function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	// Check for direct src
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}
	// Build from storageKey for local images
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}
const featuredImageUrl = getImageUrl(post.data.featured_image);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

// Generate SEO meta from content
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname,
	defaultOgImage: featuredImageUrl,
});

// Bylines are already hydrated by getEmDashEntry
const bylines = post.data.bylines ?? [];

// Get reading time
const readingTime = getReadingTime(post.data.content);

// This post's tags are already hydrated onto the entry by getEmDashEntry —
// no extra query needed.
const tags = post.data.terms?.tag ?? [];

// The first category leads the breadcrumb; posts without one sit under 記事一覧.
// Categories are already hydrated onto the entry (no extra query).
const category = post.data.terms?.category?.[0] ?? null;
const parentCrumb = category
	? { label: category.label, href: `/business/category/${category.slug}/` }
	: { label: "記事一覧", href: "/business/posts/" };

// 関連記事: 同じカテゴリの新しい順に4本（カテゴリがなければ新着）。
// この記事自身が入ることがあるので1本多めに取る。
const RELATED_COUNT = 4;
const { entries: relatedPool, cacheHint: relatedCacheHint } =
	await getEmDashCollection("posts", {
		...(category ? { where: { category: category.slug } } : {}),
		orderBy: { published_at: "desc" },
		limit: RELATED_COUNT + 1,
	});
if (Astro.cache?.enabled) Astro.cache.set(relatedCacheHint);
const otherPosts = relatedPool.filter((p) => p.id !== post.id).slice(0, RELATED_COUNT);

// 本文: WordPress の枠（わかること・CTA）を囲み直す。管理画面の編集モードではそのまま渡す
const content = getEditMeta(post.data.content)
	? post.data.content
	: groupWpBlocks(post.data.content);
const contentComponents = { type: { kGroup: WpGroup } };

// Related cards show no tags, so no term query is needed.
const otherPostsWithTags = otherPosts.map((p) => ({ post: p, tags: [] }));

const publishedAt = post.data.publishedAt ?? null;
const publishDate = publishedAt ? formatDate(publishedAt, "long") : null;

// Show an updated date only when the post was revised on a later day.
const ONE_DAY_MS = 24 * 60 * 60 * 1000;
const updatedAt = post.data.updatedAt;
const showUpdated =
	!!publishedAt && updatedAt.getTime() - publishedAt.getTime() > ONE_DAY_MS;
const updateDate = showUpdated ? formatDate(updatedAt, "long") : null;

// The script below builds the table of contents and has the final say; this
// guess keeps the sidebar from shifting when the page loads.
const hasHeadings = (post.data.content ?? []).some(
	(block) =>
		block._type === "block" &&
		"style" in block &&
		(block.style === "h2" || block.style === "h3"),
);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	author={bylines[0]?.byline.displayName ?? null}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="post">
		<header class="intro post-header">
			<div class="frame">
				<div class="post-header__inner">
					<div class="post-header__crumbs">
						<Breadcrumbs items={[parentCrumb, { label: post.data.title || "無題" }]} />
					</div>
					<div class="post-header__body">
						<div class="post-header__text">
							{
								tags.length > 0 && (
									<ul class="chips post-header__tags" aria-label="タグ">
										{tags.map((t) => (
											<li>
												<a href={`/business/tag/${t.slug}/`} class="chip">
													{t.label}
												</a>
											</li>
										))}
									</ul>
								)
							}
							<h1 class="intro__title post-header__title" {...post.edit.title}>
								{post.data.title}
							</h1>
							{
								post.data.excerpt && (
									<p class="intro__lead post-header__lead" {...post.edit.excerpt}>
										{post.data.excerpt}
									</p>
								)
							}
							<div class="post-header__meta">
								{
									bylines.length > 0 && (
										<div class="post-header__byline">
											<span class="post-header__label">執筆</span>
											<Byline bylines={bylines} layout="inline" max={2} size="md" />
										</div>
									)
								}
								<p class="post-header__dateline">
									{
										publishedAt && (
											<span>
												公開日 <time datetime={publishedAt.toISOString()}>{publishDate}</time>
											</span>
										)
									}
									{
										showUpdated && (
											<span>
												更新日 <time datetime={updatedAt.toISOString()}>{updateDate}</time>
											</span>
										)
									}
									<span>{readingTime}分で読めます</span>
								</p>
							</div>
						</div>
						{
							post.data.featured_image && (
								<div class="post-hero__media" {...post.edit.featured_image}>
									<Image
										image={post.data.featured_image}
										sizes="(min-width: 1100px) 440px, (min-width: 760px) 680px, 92vw"
										priority
									/>
								</div>
							)
						}
					</div>
				</div>
			</div>
		</header>


		<div class="band section">
			<div class="frame post-layout">
				<div class="post-main">
					<div class="prose" data-post-content>
						<PortableText value={content} components={contentComponents} />
					</div>
					<SideBanner class="banner--inline" />
					<AuthorBox />
				</div>

				<div class="post-rail">
					<SideBanner class="banner--rail" />

					<nav
						class="toc"
						aria-labelledby="toc-title"
						hidden={!hasHeadings}
						data-toc
					>
						<h2 id="toc-title" class="eyebrow">目次</h2>
						<ol class="toc__list" data-toc-list></ol>
					</nav>

					<aside class="post-widgets" aria-labelledby="widgets-title">
						<h2 id="widgets-title" class="sr-only">関連情報</h2>
						<WidgetArea name="sidebar" />
					</aside>
				</div>
			</div>
		</div>
	</article>

	{
		otherPostsWithTags.length > 0 && (
			<section class="band section" aria-labelledby="continue-reading">
				<div class="frame related">
					<div class="section-head">
						<h2 id="continue-reading" class="section-head__title">
							関連記事
						</h2>
						<a href="/business/posts/" class="arrow-link">
							記事一覧
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M5 12h14" />
								<path d="m12 5 7 7-7 7" />
							</svg>
						</a>
					</div>
					<div class="post-grid">
						{otherPostsWithTags.map(({ post: p, tags: postTags }) => (
							<PostCard
								post={p}
								tags={postTags}
								variant="card"
								headingLevel={3}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}

	<script>
		// Build the table of contents from the body's h2/h3 headings
		function buildToc() {
			const content = document.querySelector("[data-post-content]");
			const toc = document.querySelector<HTMLElement>("[data-toc]");
			const list = document.querySelector("[data-toc-list]");
			if (!content || !toc || !list) return;

			const headings = [
				...content.querySelectorAll<HTMLHeadingElement>("h2, h3"),
			];
			toc.hidden = headings.length === 0;
			if (headings.length === 0) return;

			const links = new Map<Element, HTMLAnchorElement>();
			headings.forEach((heading, index) => {
				if (!heading.id) {
					heading.id = `heading-${index}`;
				}

				const item = document.createElement("li");
				item.className =
					heading.tagName === "H3"
						? "toc__item toc__item--nested"
						: "toc__item";

				const link = document.createElement("a");
				link.href = `#${heading.id}`;
				link.className = "toc__link";
				link.textContent = heading.textContent;

				item.appendChild(link);
				list.appendChild(item);
				links.set(heading, link);
			});

			// Mark the section currently in view
			const setCurrent = (link: HTMLAnchorElement) => {
				for (const other of links.values()) {
					other.removeAttribute("aria-current");
				}
				link.setAttribute("aria-current", "true");
			};
			const first = links.values().next().value;
			if (first) setCurrent(first);

			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						const link = links.get(entry.target);
						if (link && entry.isIntersecting) setCurrent(link);
					}
				},
				{ rootMargin: "-80px 0px -80% 0px" },
			);

			headings.forEach((heading) => observer.observe(heading));
		}

		buildToc();
	</script>
</Base>

<style>
	/* Header */
	.post-header {
		padding-block: clamp(2rem, 1.25rem + 3vw, 4rem)
			clamp(2.5rem, 1.75rem + 2.5vw, 3.5rem);
	}

	.post-header__inner {
		max-width: var(--content-width);
		margin-inline: auto;
	}

	.post-header__crumbs {
		--crumb-gap: 0;
		margin-block-end: clamp(2rem, 1.5rem + 2vw, 3rem);
	}

	.post-header__tags {
		margin-block-end: var(--spacing-5);
	}

	.post-header__lead {
		font-size: var(--font-size-xl);
		line-height: var(--leading-normal);
	}

	.post-header__meta {
		--avatar-ring: var(--color-bg);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-3) var(--spacing-5);
		margin-block-start: var(--spacing-8);
	}

	/* Names wrap instead of truncating */
	.post-header__meta :global(.byline__names) {
		overflow: visible;
		white-space: normal;
	}

	.post-header__byline {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
	}

	.post-header__label {
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: var(--tracking-wide);
		color: var(--color-brand);
	}

	.post-header__dateline {
		display: flex;
		flex-wrap: wrap;
		column-gap: var(--spacing-2);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	.post-header__dateline > * + *::before {
		content: "·";
		content: "·" / "";
		margin-inline-end: var(--spacing-2);
	}

	/* Featured image */
	/* タイトルのすぐ下に、本文の幅に合わせた控えめな大きさで（アイキャッチは 1200x630） */
	.post-hero__media {
		position: relative;
		overflow: hidden;
		max-width: var(--content-width);
		margin: var(--spacing-6) 0 0;
		aspect-ratio: 1200 / 630;
		border-radius: var(--radius-xl);
		background: var(--color-fill);
	}

	.post-hero__media::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		outline: 1px solid var(--color-media-outline);
		outline-offset: -1px;
		pointer-events: none;
	}

	.post-hero__media :global(img) {
		width: 100%;
		max-width: none;
		height: 100%;
		object-fit: cover;
	}

	/* Body: one reading column, widgets after the comments */
	.post-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		row-gap: var(--spacing-16);
	}

	.toc {
		display: none;
	}

	.post-main,
	.post-rail {
		width: 100%;
		max-width: var(--content-width);
		margin-inline: auto;
	}

	.post-rail {
		overflow-wrap: anywhere;
	}

	/* Table of contents */
	.toc h2 {
		margin-block-end: var(--spacing-4);
	}

	.toc__list {
		list-style: none;
		border-inline-start: 1px solid var(--color-border);
	}

	.toc :global(.toc__link) {
		display: block;
		margin-inline-start: -1px;
		padding-block: 5px;
		padding-inline: var(--spacing-3) 0;
		border-inline-start: 2px solid transparent;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		line-height: var(--leading-snug);
		text-decoration: none;
		transition:
			color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.toc :global(.toc__item--nested .toc__link) {
		padding-inline-start: var(--spacing-6);
	}

	.toc :global(.toc__link:hover) {
		color: var(--color-text);
	}

	.toc :global(.toc__link[aria-current="true"]) {
		border-inline-start-color: var(--color-text);
		color: var(--color-text);
	}

	/* スマホ・タブレット: タイトル → 画像 → リード文 → 執筆者の順に縦に並べる */
	.post-header__body {
		display: flex;
		flex-direction: column;
	}

	.post-header__text {
		display: contents;
	}

	.post-header__tags {
		order: 1;
	}

	.post-header__title {
		order: 2;
	}

	.post-hero__media {
		order: 3;
	}

	.post-header__lead {
		order: 4;
	}

	.post-header__meta {
		order: 5;
	}

	@media (min-width: 1100px) {
		/* パソコン: 冒頭は2列。左にタイトル・リード文・執筆者、右にアイキャッチ */
		.post-header__inner {
			max-width: none;
		}

		.post-header__body {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 440px;
			align-items: center;
			gap: 3rem;
		}

		.post-header__text {
			display: block;
		}

		.post-hero__media {
			margin: 0;
		}

		.post-header__lead {
			margin-block-start: var(--spacing-5);
			font-size: var(--font-size-lg);
		}

		.post-header__meta {
			margin-block-start: var(--spacing-6);
		}

		.post-layout {
			grid-template-columns:
				minmax(36rem, var(--content-width))
				minmax(10rem, 260px);
			align-items: start;
			justify-content: space-between;
			gap: var(--spacing-10) clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
		}

		.post-rail {
			position: sticky;
			top: calc(var(--nav-height) + var(--spacing-8));
		}

		.post-main {
			max-width: none;
		}

		/* A rail taller than the viewport scrolls on its own, so every widget stays reachable */
		.post-rail {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			gap: var(--spacing-10);
			max-width: none;
			max-height: calc(100vh - var(--nav-height) - var(--spacing-16));
			max-height: calc(100dvh - var(--nav-height) - var(--spacing-16));
			margin: calc(-1 * var(--spacing-1));
			padding: var(--spacing-1);
			overflow-y: auto;
			scrollbar-width: thin;
		}

		.toc {
			display: block;
		}

		.toc[hidden] {
			display: none;
		}
	}

	/* Sidebar widgets */
	:global(.post-widgets:not(:has(.widget))) {
		display: none;
	}

	@media (max-width: 1099.98px) {
		:global(.post-rail) {
			display: none;
		}
	}

	.post-widgets {
		padding-block-start: var(--spacing-10);
		border-block-start: 1px solid var(--color-border);
	}

	/* Columns rather than a grid, so short widgets don't leave holes beside tall ones */
	.post-widgets :global(.widget-area) {
		columns: 15rem 2;
		column-gap: var(--spacing-8);
	}

	.post-widgets :global(.widget) {
		min-width: 0;
		margin-block-end: var(--spacing-10);
		font-size: var(--font-size-sm);
		break-inside: avoid;
	}

	.post-widgets :global(.widget__title) {
		margin-block-end: var(--spacing-3);
		font-family: var(--font-mono);
		font-size: var(--font-size-label);
		font-weight: 500;
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.post-widgets :global(.widget__content) {
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
	}

	.post-widgets :global(.widget__content ul) {
		list-style: none;
	}

	.post-widgets :global(.widget__content p + p) {
		margin-block-start: var(--spacing-3);
	}

	.post-widgets :global(.widget__menu ul) {
		display: grid;
		gap: var(--spacing-2);
	}

	.post-widgets
		:global(:is(.widget__menu, .widget-categories, .widget-archives) a) {
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.post-widgets
		:global(:is(.widget__menu, .widget-categories, .widget-archives) a:hover) {
		color: var(--color-text);
	}

	.post-widgets :global(.widget-search) {
		position: relative;
	}

	.post-widgets :global(.widget-search__input) {
		width: 100%;
		height: 36px;
		padding-block: 0;
		padding-inline: var(--spacing-4) 4.5rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-surface);
		color: var(--color-text);
		font: inherit;
		appearance: none;
		transition:
			border-color var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	.post-widgets :global(.widget-search__input::placeholder) {
		color: var(--color-muted);
	}

	.post-widgets :global(.widget-search__input:hover) {
		border-color: var(--color-border-strong);
	}

	.post-widgets :global(.widget-search__input:focus) {
		outline: 2px solid transparent;
		border-color: var(--color-muted);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.post-widgets :global(.widget-search__button) {
		position: absolute;
		top: 4px;
		inset-inline-end: 4px;
		height: 28px;
		padding-inline: var(--spacing-3);
		border: 0;
		border-radius: var(--radius-full);
		background: var(--color-fill);
		color: var(--color-text-secondary);
		font: inherit;
		font-size: var(--font-size-xs);
		font-weight: 500;
		cursor: pointer;
		transition:
			background-color var(--transition-fast),
			color var(--transition-fast);
	}

	.post-widgets :global(.widget-search__button:hover) {
		background: var(--color-fill-strong);
		color: var(--color-text);
	}

	.post-widgets :global(:is(.widget-categories, .widget-archives)) {
		display: grid;
		gap: var(--spacing-1);
	}

	.post-widgets :global(:is(.widget-categories, .widget-archives) li) {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-3);
		padding-block: 3px;
	}

	.post-widgets
		:global(:is(.widget-categories__count, .widget-archives__count)),
	.post-widgets :global(.widget-tags__count) {
		font-family: var(--font-mono);
		font-size: var(--font-size-label);
		color: var(--color-muted);
