---
import {
	getEmDashEntry,
	getEmDashCollection,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
	getEditMeta,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Byline from "../../components/Byline.astro";
import PostCard from "../../components/PostCard.astro";
import WpGroup from "../../components/WpGroup.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import SideBanner from "../../components/SideBanner.astro";
import PostBlock from "../../components/PostBlock.astro";
import PopularPosts from "../../components/PopularPosts.astro";
import { POPULAR_SLUGS } from "../../site-config";
import { groupWpBlocks } from "../../utils/wp-groups";
import { legacyWpPath } from "../../utils/wp-legacy";
import { buildToc, linkedSlugs, splitAtFirstH2 } from "../../utils/toc";
import { formatDate } from "../../utils/locale";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

// 取り込んだ WordPress のトップ（固定ページ top）は新しいトップへ
if (slug === "top") return Astro.redirect("/business/", 301);

// WordPress の古い住所: /business/index.php?p=… や /business/feed/ など
if (slug === "index.php") {
	return Astro.redirect(legacyWpPath(Astro.url.searchParams) ?? "/business/", 301);
}
if (slug === "feed" || slug === "comments") return Astro.redirect("/business/rss.xml", 301);
if (slug === "wp-sitemap.xml") return Astro.redirect("/business/sitemap.xml", 301);

// 記事も固定ページも /business/<slug>/ で開く。末尾の「/」がなければ付けて移動
if (!Astro.url.pathname.endsWith("/")) {
	return Astro.redirect(`/business/${encodeURIComponent(slug)}/${Astro.url.search}`, 301);
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	// 同じ slug の記事がなければ固定ページを表示する（中身は pages/[slug].astro）
	return Astro.rewrite(`/pages/${encodeURIComponent(slug)}`);
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Get featured image URL for OG fallback
// The image may have src (external) or meta.storageKey (local)
function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	// Check for direct src
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}
	// Build from storageKey for local images
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}
const featuredImageUrl = getImageUrl(post.data.featured_image);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

// Generate SEO meta from content
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname,
	defaultOgImage: featuredImageUrl,
});

// Bylines are already hydrated by getEmDashEntry
const bylines = post.data.bylines ?? [];

// Get reading time
const readingTime = getReadingTime(post.data.content);

// This post's tags are already hydrated onto the entry by getEmDashEntry —
// no extra query needed.
const tags = post.data.terms?.tag ?? [];

// The first category leads the breadcrumb; posts without one sit under 記事一覧.
// Categories are already hydrated onto the entry (no extra query).
const category = post.data.terms?.category?.[0] ?? null;
const parentCrumb = category
	? { label: category.label, href: `/business/category/${category.slug}/` }
	: { label: "記事一覧", href: "/business/posts/" };

// 関連記事: 同じカテゴリの新しい順に4本（カテゴリがなければ新着）。
// おすすめ記事の穴埋めにも使うので多めに取る。
const RELATED_COUNT = 4;
const RECOMMEND_COUNT = 5;
const { entries: relatedPool, cacheHint: relatedCacheHint } =
	await getEmDashCollection("posts", {
		...(category ? { where: { category: category.slug } } : {}),
		orderBy: { published_at: "desc" },
		limit: RELATED_COUNT + RECOMMEND_COUNT + 1,
	});
if (Astro.cache?.enabled) Astro.cache.set(relatedCacheHint);
const sameCategory = relatedPool.filter((p) => p.id !== post.id);
const otherPosts = sameCategory.slice(0, RELATED_COUNT);
const relatedIds = new Set(otherPosts.map((p) => p.id));

// おすすめ記事（パソコンの右の列）: 本文からリンクしている記事を出てくる順に。
// 下の関連記事と重なるものは除き、足りなければ同じカテゴリの記事で埋める。
const linked = linkedSlugs(post.data.content, [slug]).filter((s) => !relatedIds.has(s));
let linkedPosts: typeof sameCategory = [];
if (linked.length > 0) {
	const { entries: linkedPool, cacheHint: linkedCacheHint } = await getEmDashCollection("posts", {
		where: { slug: linked.slice(0, 20) },
		limit: 20,
	});
	if (Astro.cache?.enabled) Astro.cache.set(linkedCacheHint);
	linkedPosts = linked
		.map((s) => linkedPool.find((p) => p.id === s || p.slug === s))
		.filter((p): p is NonNullable<typeof p> => !!p);
}
const recommendedPosts = [
	...linkedPosts,
	...sameCategory.slice(RELATED_COUNT).filter((p) => !linkedPosts.some((l) => l.id === p.id)),
].slice(0, RECOMMEND_COUNT);

// 人気記事（site-config.ts の POPULAR_SLUGS の順。1回の問い合わせでまとめて取る）
const { entries: popularPool, cacheHint: popularCacheHint } = await getEmDashCollection("posts", {
	where: { slug: POPULAR_SLUGS },
	limit: POPULAR_SLUGS.length,
});
if (Astro.cache?.enabled) Astro.cache.set(popularCacheHint);
const popularPosts = POPULAR_SLUGS.map((s) => popularPool.find((p) => p.id === s || p.slug === s)).filter(
	(p): p is NonNullable<typeof p> => !!p,
);

// 本文: WordPress の枠（わかること・CTA）を囲み直す。管理画面の編集モードではそのまま渡す
const isEditing = !!getEditMeta(post.data.content);
const content = isEditing ? post.data.content : groupWpBlocks(post.data.content);
const contentComponents = { type: { kGroup: WpGroup }, block: PostBlock };

// 目次（H2・H3）。本文の中（最初の H2 の前）と、パソコンの右の列に出す
const toc = buildToc(post.data.content);
// 番号は「1」「1-1」の形（WordPress の SWELL と同じ）。長い目次は最初は畳んでおく
const TOC_FOLD_AT = 12;
let h2n = 0;
let h3n = 0;
const tocNumbered = toc.map((item) => {
	if (item.level === 2) {
		h2n++;
		h3n = 0;
		return { ...item, num: `${h2n}` };
	}
	h3n++;
	return { ...item, num: h2n > 0 ? `${h2n}-${h3n}` : `${h3n}` };
});
const [contentIntro, contentBody] = isEditing
	? [[], content]
	: splitAtFirstH2(content as unknown[]);

// Related cards show no tags, so no term query is needed.
const otherPostsWithTags = otherPosts.map((p) => ({ post: p, tags: [] }));

const publishedAt = post.data.publishedAt ?? null;
const publishDate = publishedAt ? formatDate(publishedAt, "long") : null;

// Show an updated date only when the post was revised on a later day.
const ONE_DAY_MS = 24 * 60 * 60 * 1000;
const updatedAt = post.data.updatedAt;
const showUpdated =
	!!publishedAt && updatedAt.getTime() - publishedAt.getTime() > ONE_DAY_MS;
const updateDate = showUpdated ? formatDate(updatedAt, "long") : null;

---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	author={bylines[0]?.byline.displayName ?? null}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="crumb-band">
		<div class="frame">
			<Breadcrumbs items={[parentCrumb, { label: post.data.title || "無題" }]} hideCurrent />
		</div>
	</div>

	<article class="post">
		<header class="intro post-header">
			<div class="frame">
				<div class="post-header__inner">
					<div class="post-header__body">
						<div class="post-header__text">
							{
								category && (
									<a href={`/business/category/${category.slug}/`} class="post-header__cat">
										{category.label}
									</a>
								)
							}
							{
								tags.length > 0 && (
									<ul class="chips post-header__tags" aria-label="タグ">
										{tags.map((t) => (
											<li>
												<a href={`/business/tag/${t.slug}/`} class="chip">
													{t.label}
												</a>
											</li>
										))}
									</ul>
								)
							}
							<h1 class="intro__title post-header__title" {...post.edit.title}>
								{post.data.title}
							</h1>
							{
								post.data.excerpt && (
									<p class="intro__lead post-header__lead" {...post.edit.excerpt}>
										{post.data.excerpt}
									</p>
								)
							}
							<div class="post-header__meta">
								{
									bylines.length > 0 && (
										<div class="post-header__byline">
											<span class="post-header__label">執筆</span>
											<Byline bylines={bylines} layout="inline" max={2} size="md" />
										</div>
									)
								}
								<p class="post-header__dateline">
									{
										publishedAt && (
											<span>
												公開日 <time datetime={publishedAt.toISOString()}>{publishDate}</time>
											</span>
										)
									}
									{
										showUpdated && (
											<span>
												更新日 <time datetime={updatedAt.toISOString()}>{updateDate}</time>
											</span>
										)
									}
									<span>{readingTime}分で読めます</span>
								</p>
							</div>
						</div>
						{
							post.data.featured_image && (
								<div class="post-hero__media" {...post.edit.featured_image}>
									<Image
										image={post.data.featured_image}
										sizes="(min-width: 1100px) 760px, (min-width: 760px) 680px, 92vw"
										priority
									/>
								</div>
							)
						}
					</div>
				</div>
			</div>
		</header>


		<div class="band section">
			<div class="frame post-layout">
				<div class="post-main">
					<div class="prose" data-post-content>
						{
							isEditing ? (
								<PortableText value={content} components={contentComponents} />
							) : (
								<>
									{contentIntro.length > 0 && (
										<PortableText value={contentIntro} components={contentComponents} />
									)}
									{toc.length > 0 && (
										<nav
											class:list={["intoc", { "is-folded": toc.length > TOC_FOLD_AT }]}
											aria-labelledby="intoc-title"
											data-intoc
										>
											<p id="intoc-title" class="intoc__title">
												<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
												目次
											</p>
											<ol class="intoc__list">
												{tocNumbered.map((item) => (
													<li class:list={["intoc__item", { "intoc__item--sub": item.level === 3 }]}>
														<a href={`#${item.id}`}>
															<span class="intoc__num">{item.num}</span>
															<span>{item.text}</span>
														</a>
													</li>
												))}
											</ol>
											{toc.length > TOC_FOLD_AT && (
												<button type="button" class="intoc__more" data-intoc-toggle aria-expanded="false">
													もっと見る
												</button>
											)}
										</nav>
									)}
									<PortableText value={contentBody} components={contentComponents} />
								</>
							)
						}
					</div>
					<SideBanner class="banner--inline" />
					<AuthorBox />
					<PopularPosts posts={popularPosts} class="popular--inline" />
				</div>

				<div class="post-rail">
					<SideBanner class="banner--rail" />

					<PopularPosts
						posts={recommendedPosts}
						title="おすすめ記事"
						ranked={false}
						class="popular--rail"
					/>

					<PopularPosts posts={popularPosts} class="popular--rail" />

				</div>
			</div>
		</div>
	</article>

	{
		otherPostsWithTags.length > 0 && (
			<section class="band section" aria-labelledby="continue-reading">
				<div class="frame related">
					<div class="section-head">
						<h2 id="continue-reading" class="section-head__title">
							関連記事
						</h2>
						<a href="/business/posts/" class="arrow-link">
							記事一覧
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M5 12h14" />
								<path d="m12 5 7 7-7 7" />
							</svg>
						</a>
					</div>
					<div class="post-grid">
						{otherPostsWithTags.map(({ post: p, tags: postTags }) => (
							<PostCard
								post={p}
								tags={postTags}
								variant="card"
								headingLevel={3}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}

	<script>


		// 本文の目次の「もっと見る / 閉じる」
		for (const button of document.querySelectorAll<HTMLButtonElement>("[data-intoc-toggle]")) {
			button.addEventListener("click", () => {
				const nav = button.closest("[data-intoc]");
				if (!nav) return;
				const folded = nav.classList.toggle("is-folded");
				button.textContent = folded ? "もっと見る" : "閉じる";
				button.setAttribute("aria-expanded", String(!folded));
			});
		}
	</script>
</Base>

<style>
	/* Header */
	.post-header {
		padding-block: clamp(1.25rem, 1rem + 1vw, 2rem)
			clamp(2rem, 1.5rem + 2vw, 3rem);
	}

	.post-header__inner {
		max-width: var(--content-width);
		margin-inline: auto;
	}


	.post-header__tags {
		margin-block-end: var(--spacing-5);
	}

	.post-header__lead {
		font-size: var(--font-size-xl);
		line-height: var(--leading-normal);
	}

	.post-header__meta {
		--avatar-ring: var(--color-bg);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-3) var(--spacing-5);
		margin-block-start: var(--spacing-8);
	}

	/* Names wrap instead of truncating */
	.post-header__meta :global(.byline__names) {
		overflow: visible;
		white-space: normal;
	}

	.post-header__byline {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
	}

	.post-header__label {
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: var(--tracking-wide);
		color: var(--color-brand);
	}

	.post-header__dateline {
		display: flex;
		flex-wrap: wrap;
		column-gap: var(--spacing-2);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	.post-header__dateline > * + *::before {
		content: "·";
		content: "·" / "";
		margin-inline-end: var(--spacing-2);
	}

	/* Featured image */
	/* タイトルのすぐ下に、本文の幅に合わせた控えめな大きさで（アイキャッチは 1200x630） */
	.post-hero__media {
		position: relative;
		overflow: hidden;
		max-width: var(--content-width);
		margin: var(--spacing-6) 0 0;
		aspect-ratio: 1200 / 630;
		border-radius: var(--radius-xl);
		background: var(--color-fill);
	}

	.post-hero__media::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		outline: 1px solid var(--color-media-outline);
		outline-offset: -1px;
		pointer-events: none;
	}

	.post-hero__media :global(img) {
		width: 100%;
		max-width: none;
		height: 100%;
		object-fit: cover;
	}

	/* Body: one reading column, widgets after the comments */
	.post-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		row-gap: var(--spacing-16);
	}

	.toc {
		display: none;
	}

	.post-main,
	.post-rail {
		width: 100%;
		max-width: var(--content-width);
		margin-inline: auto;
	}

	.post-rail {
		overflow-wrap: anywhere;
	}

	/* Table of contents */
	.toc h2 {
		margin-block-end: var(--spacing-4);
	}

	.toc__list {
		list-style: none;
		border-inline-start: 1px solid var(--color-border);
	}

	.toc .toc__link {
		display: block;
		margin-inline-start: -1px;
		padding-block: 5px;
		padding-inline: var(--spacing-3) 0;
		border-inline-start: 2px solid transparent;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		line-height: var(--leading-snug);
		text-decoration: none;
		transition:
			color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.toc .toc__item--nested .toc__link {
		padding-inline-start: var(--spacing-6);
	}

	.toc .toc__link:hover {
		color: var(--color-text);
	}

	.toc .toc__link[aria-current="true"] {
		border-inline-start-color: var(--color-text);
		color: var(--color-text);
	}

	/* スマホ・タブレット: タイトル → 画像 → リード文 → 執筆者の順に縦に並べる */
	.post-header__body {
		display: flex;
		flex-direction: column;
	}

	.post-header__text {
		display: contents;
	}

	.post-header__tags {
		order: 1;
	}

	.post-header__title {
		order: 2;
	}

	.post-hero__media {
		order: 3;
	}

	.post-header__lead {
		order: 4;
	}

	.post-header__meta {
		order: 5;
	}

	@media (min-width: 1100px) {
		/* パソコン: 冒頭は横幅いっぱいに、タイトル（1行）→ 画像 → 導入文 → 執筆者 */
		.post-header__inner {
			max-width: none;
		}

		.post-header__title {
			max-width: none;
			font-size: clamp(1.5rem, 0.9rem + 1vw, 1.875rem);
		}

		.post-hero__media {
			max-width: 760px;
		}

		.post-header__lead {
			max-width: none;
			margin-block-start: var(--spacing-6);
		}

		.post-layout {
			grid-template-columns:
				minmax(36rem, var(--content-width))
				minmax(10rem, 300px);
			align-items: start;
			justify-content: space-between;
			gap: var(--spacing-10) clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
		}

		.post-main {
			max-width: none;
		}

		/* 右の列はページと一緒にスクロールする（列の中だけのスクロールはしない） */
		.post-rail {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			gap: var(--spacing-8);
			max-width: none;
		}

		.toc {
			display: block;
		}

		.toc[hidden] {
			display: none;
		}
	}

	/* スマホ・タブレットでは右の列を出さない（バナー・人気記事は本文の下に別に出す） */
	@media (max-width: 1099.98px) {
		.post-rail {
			display: none;
		}
	}

	/* Continue reading */
	.related {
		container-type: inline-size;
	}

	.related .post-grid {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
	}

	/* 本文の中の目次（最初の H2 の前）。WordPress の SWELL に近い形 */
	.intoc {
		position: relative;
		margin-block: 2rem 2.5rem;
		padding: 1.25rem 1.5rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: #f7fbfb;
	}

	.intoc__title {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		margin: 0 0 0.875rem !important;
		font-size: 0.9375rem;
		font-weight: 700;
		color: var(--color-navy);
	}

	.intoc__title svg {
		width: 16px;
		height: 16px;
		color: var(--color-teal);
	}

	.intoc__list {
		margin: 0 !important;
		padding: 0 !important;
		list-style: none !important;
	}

	.intoc.is-folded .intoc__list {
		max-height: 19rem;
		overflow: hidden;
		mask-image: linear-gradient(to bottom, #000 70%, transparent);
	}

	.intoc__item {
		margin: 0 !important;
		padding: 0 !important;
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.intoc__item::before {
		content: none !important;
	}

	.intoc__item + .intoc__item:not(.intoc__item--sub) {
		margin-block-start: 0.5rem !important;
	}

	.intoc__item--sub {
		padding-inline-start: 1.25rem !important;
		font-size: 0.8125rem;
	}

